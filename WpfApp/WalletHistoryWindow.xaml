<Window x:Class="WpfApp.WalletHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lịch sử giao dịch ví" Height="480" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="tbBalance" Text="Số dư hiện tại: 0"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        <Button Grid.Row="1" Content="Reload" Width="90" Height="28"
                HorizontalAlignment="Left" Margin="0,0,0,8" Click="BtnReload_Click"/>

        <DataGrid Grid.Row="2" x:Name="dgTransactions"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding TransactionId}" Width="50"/>
                <DataGridTextColumn Header="Loại" Binding="{Binding TransactionType}" Width="90"/>
                <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount}" Width="105"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAt}" Width="140"/>
                <DataGridTextColumn Header="MoMo Order" Binding="{Binding MomoOrderId}" Width="190"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
