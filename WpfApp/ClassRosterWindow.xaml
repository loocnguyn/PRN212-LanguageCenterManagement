<Window x:Class="WpfApp.ClassRosterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Roster" Height="560" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="tbTeacherInfo" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
        <!-- Filter Panel: Semester -> Course -> Class -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Semester:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cboSemester" Width="170" Height="28" DisplayMemberPath="Name"
                      SelectionChanged="CboSemester_SelectionChanged" VerticalContentAlignment="Center"/>
            <TextBlock Text="Course:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="cboCourse" Width="200" Height="28" DisplayMemberPath="Name"
                      SelectionChanged="CboCourse_SelectionChanged" VerticalContentAlignment="Center"/>
            <TextBlock Text="Class:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="cboClass" Width="200" Height="28" DisplayMemberPath="Name" 
                      SelectionChanged="CboClass_SelectionChanged" VerticalContentAlignment="Center"/>
            <Button Content="Reset" Width="80" Height="28" Margin="6,0,0,0" Click="BtnReset_Click"/>
        </StackPanel>
        <DataGrid Grid.Row="2" x:Name="dgRoster"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student ID"   Binding="{Binding StudentId}"   Width="100"/>
                <DataGridTextColumn Header="Full Name"    Binding="{Binding FullName}"     Width="200"/>
                <DataGridTextColumn Header="Gender"       Binding="{Binding Gender}"       Width="80"/>
                <DataGridTextColumn Header="Phone"        Binding="{Binding Phone}"        Width="130"/>
                <DataGridTextColumn Header="Email"        Binding="{Binding Email}"        Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>