<Window x:Class="WpfApp.EnrollmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enrollment Management" Height="620" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Active Semester Info -->
        <Border Grid.Row="0" Background="#F0F4F8" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontWeight="Bold" FontSize="14">Active Semester:</TextBlock>
                <TextBlock x:Name="tbActiveSemester" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="tbActivePhase" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Enroll Section -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Class:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cboClass" Width="240" Height="28" DisplayMemberPath="Name" VerticalContentAlignment="Center"/>
            <TextBlock Text="Student ID:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox x:Name="txtStudentId" Width="100" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>
            <Button Content="Enroll" Width="80" Height="28" Margin="8,0,0,0" Click="BtnEnroll_Click"/>
            <Button Content="Change Class" Width="110" Height="28" Margin="6,0,0,0" Click="BtnChangeClass_Click"/>
            <Button Content="Refresh" Width="80" Height="28" Margin="6,0,0,0" Click="BtnRefresh_Click"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" x:Name="dgEnrollments"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="DgEnrollments_SelectionChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="DROPPED">
                            <Setter Property="Background" Value="#FFE0E0"/>
                            <Setter Property="Foreground" Value="#990000"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding EnrollmentId}" Width="50"/>
                <DataGridTextColumn Header="Student ID" Binding="{Binding StudentId}" Width="80"/>
                <DataGridTextColumn Header="Student Name" Binding="{Binding Student.FullName}" Width="160"/>
                <DataGridTextColumn Header="Class" Binding="{Binding Class.Name}" Width="180"/>
                <DataGridTextColumn Header="Enrolled Date" Binding="{Binding EnrolledDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Drop" Width="90" Height="32" Click="BtnDrop_Click"/>
        </StackPanel>
    </Grid>
</Window>
