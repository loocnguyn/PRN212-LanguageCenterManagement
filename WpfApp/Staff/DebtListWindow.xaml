<Window x:Class="WpfApp.DebtListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="Debt List" Height="700" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- UNPAID red, PARTIAL amber-ish (info), anything else grey -->
        <DataTemplate x:Key="DebtStatusTemplate">
            <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource TextSecondaryBrush}">
                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="UNPAID">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="PARTIAL">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Student name + id -->
        <DataTemplate x:Key="DebtStudentTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{Binding StudentId, StringFormat='Student #{0}'}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header band — red, this screen is about money owed -->
        <Border DockPanel.Dock="Top" Background="{StaticResource DangerBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ReceiptMoney24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Debt List" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Outstanding tuition by student, class and due date"
                               Foreground="#FFE1E2" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Totals -->
            <UniformGrid Grid.Row="0" Rows="1" Columns="3" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="statDebtors" Text="0" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Invoices with debt" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="statOutstanding" Text="0 đ" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="Total outstanding" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="statOverdue" Text="0" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource InfoBrush}"/>
                        <TextBlock Text="Overdue" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Search + advanced filter -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtSearch" Width="240" Height="34"
                                 VerticalContentAlignment="Center" Padding="6,0"/>
                        <TextBlock Text="Status:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ComboBox x:Name="cmbStatus" Width="130" Height="34" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="UNPAID"/>
                            <ComboBoxItem Content="PARTIAL"/>
                        </ComboBox>
                        <Button Content="Search" Style="{StaticResource PillButton}" Width="84"
                                Margin="12,0,0,0" Click="BtnSearch_Click"/>
                        <Button Content="Advanced" Style="{StaticResource PillButtonInfo}" Width="100"
                                Margin="8,0,0,0" Click="BtnAdvanced_Click"/>
                        <Button Content="Clear" Style="{StaticResource PillButtonSubtle}" Width="84"
                                Margin="8,0,0,0" Click="BtnClear_Click"/>
                    </StackPanel>

                    <Border x:Name="advancedPanel" Visibility="Collapsed"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Due from:" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dpDueFrom" Height="34"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="to" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="0" Grid.Column="3" x:Name="dpDueTo" Height="34"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Debt:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="5" x:Name="cmbDebtType" Height="34" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Overdue"/>
                                <ComboBoxItem Content="Not Overdue"/>
                            </ComboBox>
                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Remaining min:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="7" x:Name="txtRemainingMin" Height="34" Padding="6,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="8" Text="max:" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="9" x:Name="txtRemainingMax" Height="34" Padding="6,0" VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Semester:" Margin="0,10,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbSemester" Height="34" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Course:" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cmbCourse" Height="34" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Class:" Margin="12,10,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="5" x:Name="cmbClass" Height="34" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="6" Text="Teacher:" Margin="12,10,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="7" Grid.ColumnSpan="3" x:Name="cmbTeacher" Height="34" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Debt grid -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgDebts" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="48" BorderThickness="0"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceId}" Width="80"/>
                            <DataGridTemplateColumn Header="Student" Width="*" CellTemplate="{StaticResource DebtStudentTemplate}"/>
                            <DataGridTextColumn Header="Semester" Binding="{Binding SemesterName}" Width="120"/>
                            <DataGridTextColumn Header="Course" Binding="{Binding CourseName}" Width="150"/>
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="110"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" Width="110"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} đ'}" Width="110"/>
                            <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0} đ'}" Width="120"/>
                            <DataGridTemplateColumn Header="Status" Width="110" CellTemplate="{StaticResource DebtStatusTemplate}"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="46"
                                       Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No outstanding debt" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="Every invoice matching these filters is fully paid."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer: pager -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <ctl:PagerBar x:Name="pager" HorizontalAlignment="Left" PageChanged="Pager_PageChanged"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
