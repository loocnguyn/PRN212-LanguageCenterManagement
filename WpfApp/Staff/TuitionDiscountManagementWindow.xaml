<Window x:Class="WpfApp.TuitionDiscountManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tuition Discount Management" Height="620" Width="1160"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtSearch" Width="260" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox x:Name="cmbStatusFilter" Width="130" Height="30">
                <ComboBoxItem Content="All" IsSelected="True"/>
                <ComboBoxItem Content="Active"/>
                <ComboBoxItem Content="Inactive"/>
            </ComboBox>
            <Button Content="Search" Width="90" Height="30" Margin="8,0,0,0" Click="BtnSearch_Click"/>
            <Button Content="Clear" Width="90" Height="30" Margin="6,0,0,0" Click="BtnClear_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgDiscounts"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding DiscountId}" Width="55"/>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="230"/>
                <DataGridTextColumn Header="Type" Binding="{Binding DiscountType}" Width="90"/>
                <DataGridTextColumn Header="Value" Binding="{Binding DiscountValue}" Width="90"/>
                <DataGridTextColumn Header="Condition" Binding="{Binding ConditionType}" Width="135"/>
                <DataGridTextColumn Header="Deadline Days" Binding="{Binding PaymentDeadlineDays}" Width="105"/>
                <DataGridTextColumn Header="Start" Binding="{Binding StartDate}" Width="100"/>
                <DataGridTextColumn Header="End" Binding="{Binding EndDate}" Width="100"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="75"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="txtCount" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add" Width="90" Height="32" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                <Button Content="Edit" Width="90" Height="32" Margin="0,0,8,0" Click="BtnEdit_Click"/>
                <Button Content="Delete/Deactivate" Width="130" Height="32" Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
