<Window x:Class="WpfApp.TuitionDiscountManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="Tuition Discount Management" Height="660" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate x:Key="DiscountStatusTemplate">
            <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource SecondaryBrush}">
                <TextBlock x:Name="txt" Text="Active" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter TargetName="txt" Property="Text" Value="Inactive"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Code as the headline, name underneath -->
        <DataTemplate x:Key="DiscountCellTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{Binding Name}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <!-- PERCENT shows n%, FIXED shows the amount -->
        <DataTemplate x:Key="DiscountValueTemplate">
            <TextBlock x:Name="txt" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Text="{Binding DiscountValue, StringFormat='{}{0:N0} đ'}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DiscountType}" Value="PERCENT">
                    <Setter TargetName="txt" Property="Text"
                            Value="{Binding DiscountValue, StringFormat='{}{0:0.##}%'}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Tag24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tuition Discounts" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Create and manage discount codes and scholarship vouchers"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtSearch" Width="250" Height="34"
                             VerticalContentAlignment="Center" Padding="6,0"/>
                    <TextBlock Text="Status:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox x:Name="cmbStatusFilter" Width="130" Height="34" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Inactive"/>
                    </ComboBox>
                    <Button Content="Search" Style="{StaticResource PillButton}" Width="90"
                            Margin="12,0,0,0" Click="BtnSearch_Click"/>
                    <Button Content="Clear" Style="{StaticResource PillButtonSubtle}" Width="90"
                            Margin="8,0,0,0" Click="BtnClear_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgDiscounts" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="48" BorderThickness="0"
                              Background="Transparent" MouseDoubleClick="DgDiscounts_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding DiscountId}" Width="55"/>
                            <DataGridTemplateColumn Header="Discount" Width="*" CellTemplate="{StaticResource DiscountCellTemplate}"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding DiscountType}" Width="100"/>
                            <DataGridTemplateColumn Header="Value" Width="110" CellTemplate="{StaticResource DiscountValueTemplate}"/>
                            <DataGridTextColumn Header="Condition" Binding="{Binding ConditionType}" Width="140"/>
                            <DataGridTextColumn Header="Deadline (days)" Binding="{Binding PaymentDeadlineDays}" Width="115"/>
                            <DataGridTextColumn Header="Start" Binding="{Binding StartDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="105"/>
                            <DataGridTextColumn Header="End" Binding="{Binding EndDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="105"/>
                            <DataGridTemplateColumn Header="Status" Width="110" CellTemplate="{StaticResource DiscountStatusTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="Tag24" FontSize="44"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No discounts found" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="Add a discount code, or clear the search filters."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer: pager + actions -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <ctl:PagerBar x:Name="pager" HorizontalAlignment="Left" PageChanged="Pager_PageChanged"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Add"  Style="{StaticResource PillButton}"        Width="90" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                    <Button Content="Edit" Style="{StaticResource PillButtonSuccess}" Width="90" Margin="0,0,8,0" Click="BtnEdit_Click"/>
                    <Button Content="Delete / Deactivate" Style="{StaticResource PillButtonDanger}" Width="170" Click="BtnDelete_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
