<Window x:Class="WpfApp.InvoiceManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="Invoice Management" Height="720" Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- PAID green · PARTIAL teal · UNPAID red · CANCELLED grey -->
        <DataTemplate x:Key="InvoiceStatusTemplate">
            <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource TextSecondaryBrush}">
                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="PAID">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="PARTIAL">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="UNPAID">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="InvoiceStudentTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{Binding StudentId, StringFormat='Student #{0}'}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Course over class, so the wide academic columns collapse into one -->
        <DataTemplate x:Key="InvoiceCourseTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding CourseName}" FontSize="13"/>
                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding ClassName, Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding SemesterName, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Receipt24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Invoice Management" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Search, review and edit tuition invoices"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Totals -->
            <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="statCount" Text="0" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Invoices" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="statBilled" Text="0 đ" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Total billed" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="statPaid" Text="0 đ" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryBrush}"/>
                        <TextBlock Text="Collected" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="statRemaining" Text="0 đ" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="Outstanding" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Search + advanced filter -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtSearch" Width="220" Height="34"
                                 VerticalContentAlignment="Center" Padding="6,0"/>
                        <TextBlock Text="Status:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ComboBox x:Name="cmbStatus" MinWidth="130" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="UNPAID"/>
                            <ComboBoxItem Content="PAID"/>
                            <ComboBoxItem Content="PARTIAL"/>
                            <ComboBoxItem Content="CANCELLED"/>
                        </ComboBox>
                        <Button Content="Search" Style="{StaticResource PillButton}" Width="84"
                                Margin="12,0,0,0" Click="BtnSearch_Click"/>
                        <Button Content="Advanced" Style="{StaticResource PillButtonInfo}" Width="100"
                                Margin="8,0,0,0" Click="BtnAdvanced_Click"/>
                        <Button Content="Clear" Style="{StaticResource PillButtonSubtle}" Width="84"
                                Margin="8,0,0,0" Click="BtnClear_Click"/>
                    </StackPanel>

                    <Border x:Name="advancedPanel" Visibility="Collapsed"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Due date:" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dpDueFrom" Height="34"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="to" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="0" Grid.Column="3" x:Name="dpDueTo" Height="34"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Payment:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="5" x:Name="cmbPaymentState" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Has Debt"/>
                                <ComboBoxItem Content="Paid Full"/>
                                <ComboBoxItem Content="No Payment"/>
                                <ComboBoxItem Content="Has Payment"/>
                            </ComboBox>
                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Discount:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="7" x:Name="cmbDiscountStatus" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="NONE"/>
                                <ComboBoxItem Content="ACTIVE"/>
                                <ComboBoxItem Content="LOCKED"/>
                                <ComboBoxItem Content="EXPIRED"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Created:" Margin="0,10,0,0" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dpCreatedFrom" Height="34" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="to" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="1" Grid.Column="3" x:Name="dpCreatedTo" Height="34" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Amount min:" Margin="12,10,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="5" x:Name="txtAmountMin" Height="34" Margin="0,10,0,0" Padding="6,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="6" Text="Remaining min:" Margin="12,10,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="7" x:Name="txtRemainingMin" Height="34" Margin="0,10,0,0" Padding="6,0" VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Semester:" Margin="0,10,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbSemester" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Course:" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="3" x:Name="cmbCourse" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="Class:" Margin="12,10,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="5" x:Name="cmbClass" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="6" Text="Teacher:" Margin="12,10,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="7" x:Name="cmbTeacher" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Invoice grid -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgInvoices" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="48" BorderThickness="0"
                              Background="Transparent" MouseDoubleClick="DgInvoices_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding InvoiceId}" Width="60"/>
                            <DataGridTemplateColumn Header="Student" Width="180" CellTemplate="{StaticResource InvoiceStudentTemplate}"/>
                            <DataGridTemplateColumn Header="Course / class" Width="*" CellTemplate="{StaticResource InvoiceCourseTemplate}"/>
                            <DataGridTextColumn Header="Original" Binding="{Binding OriginalAmount, StringFormat='{}{0:N0} đ'}" Width="110"/>
                            <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat='{}{0:N0} đ'}" Width="110"/>
                            <DataGridTextColumn Header="Final" Binding="{Binding Amount, StringFormat='{}{0:N0} đ'}" Width="115"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} đ'}" Width="115"/>
                            <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0} đ'}" Width="120"/>
                            <DataGridTemplateColumn Header="Status" Width="110" CellTemplate="{StaticResource InvoiceStatusTemplate}"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="44"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No invoices match these filters" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="Try widening the search or clearing the advanced filters."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer: pager + actions -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <ctl:PagerBar x:Name="pager" HorizontalAlignment="Left" PageChanged="Pager_PageChanged"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Edit" Style="{StaticResource PillButtonSuccess}" Width="90" Click="BtnEdit_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
