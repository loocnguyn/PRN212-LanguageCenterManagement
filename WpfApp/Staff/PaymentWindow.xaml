<Window x:Class="WpfApp.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="Payment" Height="780" Width="1140"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate x:Key="PayStatusTemplate">
            <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource TextSecondaryBrush}">
                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="UNPAID">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="PARTIAL">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PayStudentTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{Binding StudentId, StringFormat='Student #{0}'}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PayCourseTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding CourseName}" FontSize="13"/>
                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding ClassName, Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding SemesterName, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SecondaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Money24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Record Payment" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Pick an outstanding invoice, then record the amount received"
                               Foreground="#DFF6DD" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search + advanced filter -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtSearch" Width="220" Height="34"
                                 VerticalContentAlignment="Center" Padding="6,0"/>
                        <TextBlock Text="Status:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ComboBox x:Name="cmbInvoiceStatus" MinWidth="130" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="UNPAID"/>
                            <ComboBoxItem Content="PARTIAL"/>
                        </ComboBox>
                        <Button Content="Search" Style="{StaticResource PillButton}" Width="84"
                                Margin="12,0,0,0" Click="BtnSearch_Click"/>
                        <Button Content="Advanced" Style="{StaticResource PillButtonInfo}" Width="100"
                                Margin="8,0,0,0" Click="BtnAdvanced_Click"/>
                        <Button Content="Clear" Style="{StaticResource PillButtonSubtle}" Width="84"
                                Margin="8,0,0,0" Click="BtnClear_Click"/>
                    </StackPanel>

                    <Border x:Name="advancedPanel" Visibility="Collapsed"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Due from:" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dpDueFrom" Height="34"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="to" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="0" Grid.Column="3" x:Name="dpDueTo" Height="34"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Remaining min:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="5" x:Name="txtRemainingMin" Height="34" Padding="6,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Overdue:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="7" x:Name="cmbOverdue" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Overdue"/>
                                <ComboBoxItem Content="Not Overdue"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Semester:" Margin="0,10,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbSemester" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Course:" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cmbCourse" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Class:" Margin="12,10,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="5" x:Name="cmbClass" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="6" Text="Teacher:" Margin="12,10,0,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="7" Grid.ColumnSpan="2" x:Name="cmbTeacher" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Outstanding invoices -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgInvoices" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="48" BorderThickness="0"
                              Background="Transparent" SelectionChanged="DgInvoices_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceId}" Width="80"/>
                            <DataGridTemplateColumn Header="Student" Width="180" CellTemplate="{StaticResource PayStudentTemplate}"/>
                            <DataGridTemplateColumn Header="Course / class" Width="*" CellTemplate="{StaticResource PayCourseTemplate}"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:N0} đ'}" Width="120"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} đ'}" Width="120"/>
                            <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0} đ'}" Width="130"/>
                            <DataGridTemplateColumn Header="Status" Width="110" CellTemplate="{StaticResource PayStatusTemplate}"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="46"
                                       Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nothing left to collect" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="No unpaid or partially paid invoices match these filters."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pager -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <ctl:PagerBar x:Name="pager" HorizontalAlignment="Left" PageChanged="Pager_PageChanged"/>
            </Grid>

            <!-- Payment form -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Payment details" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/><ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="95"/><ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Invoice ID:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtInvoiceId" Height="34"
                                 Margin="0,6,16,6" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Padding="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Remaining:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtRemaining" Height="34"
                                 Margin="0,6,16,6" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Padding="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Staff:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="5" x:Name="txtStaff" Height="34"
                                 Margin="0,6" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Padding="6,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Amount paid:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAmountPaid" Height="34"
                                 Margin="0,6,16,6"
                                 VerticalContentAlignment="Center" Padding="6,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Method:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cmbMethod"
                                  Margin="0,6,16,6" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Cash" IsSelected="True"/>
                            <ComboBoxItem Content="Transfer"/>
                            <ComboBoxItem Content="Card"/>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Note:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="5" x:Name="txtNote" Height="34" Margin="0,6"
                                 VerticalContentAlignment="Center" Padding="6,0"/>
                    </Grid>

                    <Button Content="Record Payment" Style="{StaticResource PillButtonSuccess}"
                            Width="160" HorizontalAlignment="Right" Margin="0,14,0,0"
                            Click="BtnPay_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
