<UserControl x:Class="WpfApp.Controls.PagerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="btnFirst" Content="«" Style="{StaticResource PagerButton}" Margin="0,0,4,0"
                ToolTip="First page" Click="BtnFirst_Click"/>
        <Button x:Name="btnPrev"  Content="‹" Style="{StaticResource PagerButton}" Margin="0,0,4,0"
                ToolTip="Previous page" Click="BtnPrev_Click"/>
        <TextBlock x:Name="txtPage" VerticalAlignment="Center" Margin="8,0" MinWidth="90"
                   TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
        <Button x:Name="btnNext" Content="›" Style="{StaticResource PagerButton}" Margin="4,0,4,0"
                ToolTip="Next page" Click="BtnNext_Click"/>
        <Button x:Name="btnLast" Content="»" Style="{StaticResource PagerButton}"
                ToolTip="Last page" Click="BtnLast_Click"/>
        <TextBlock x:Name="txtRange" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
    </StackPanel>
</UserControl>
