<Window x:Class="WpfApp.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Set a new password"
        Height="420" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="0" Fill="{StaticResource PrimaryBrush}"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20" Padding="24">
            <StackPanel>
                <Border Width="48" Height="48" CornerRadius="24"
                        Background="{StaticResource PrimaryLightBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="22"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                </Border>

                <TextBlock Text="Choose your own password" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="tbSubtitle" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,6,0,16"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <TextBlock Text="New password" FontSize="12" Margin="0,0,0,4"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <PasswordBox x:Name="pwdNew" Height="34" VerticalContentAlignment="Center"
                             Padding="8,0" Margin="0,0,0,12"/>

                <TextBlock Text="Confirm new password" FontSize="12" Margin="0,0,0,4"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <PasswordBox x:Name="pwdConfirm" Height="34" VerticalContentAlignment="Center"
                             Padding="8,0" Margin="0,0,0,8"/>

                <TextBlock x:Name="tbError" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Save"      Style="{StaticResource PillButton}"       Width="100"
                            Margin="0,0,8,0" Click="BtnSave_Click"/>
                    <Button Content="Sign out"  Style="{StaticResource PillButtonSubtle}" Width="100"
                            Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
