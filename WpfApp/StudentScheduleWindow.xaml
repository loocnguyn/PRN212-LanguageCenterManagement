<Window x:Class="WpfApp.StudentScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Schedule" Height="720" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: auto-loaded, no manual ID input -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="tbStudentName" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                <TextBlock Text=" — " VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource PrimaryDarkBrush}"/>
                <TextBlock x:Name="tbSemesterInfo" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource PrimaryDarkBrush}"/>
            </StackPanel>
        </Border>

        <!-- Semester selection -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock Text="Select Semester:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <ComboBox x:Name="cbSemester" Width="300" Height="30" VerticalAlignment="Center" SelectionChanged="CbSemester_SelectionChanged"/>
        </StackPanel>

        <!-- Week navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="btnPrevWeek" Content="&lt; Previous Week" Width="140" Height="30" Click="BtnPrevWeek_Click"/>
            <TextBlock x:Name="tbWeekRange" VerticalAlignment="Center" Margin="14,0" FontWeight="Bold" FontSize="13"/>
            <Button x:Name="btnNextWeek" Content="Next Week &gt;" Width="140" Height="30" Click="BtnNextWeek_Click"/>
        </StackPanel>

        <!-- Summary -->
        <TextBlock Grid.Row="3" x:Name="tbSummary" Margin="0,0,0,8" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>

        <!-- FAP-style weekly grid, built in code-behind -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="scheduleGrid"/>
        </ScrollViewer>
    </Grid>
</Window>
