<Window x:Class="WpfApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Language Center — Login"
        Height="500" Width="420" MinHeight="500" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Accent bar -->
        <Rectangle Grid.Row="0" Fill="{StaticResource PrimaryBrush}"/>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                CornerRadius="8" Margin="24" Padding="32"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo badge -->
                <Border Grid.Row="0" Width="56" Height="56" CornerRadius="28"
                        Background="{StaticResource PrimaryLightBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <ui:SymbolIcon Symbol="BookOpen24" FontSize="26"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                </Border>

                <TextBlock Grid.Row="1" Text="Language Center Management"
                           FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Grid.Row="2" Text="Sign in to continue" Margin="0,4,0,0"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon Symbol="PersonCircle24" FontSize="14" Margin="0,0,4,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Username" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <TextBox Grid.Row="5" x:Name="txtUsername"
                         Height="36" FontSize="14"
                         VerticalContentAlignment="Center" Padding="8,0"/>

                <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Margin="0,0,4,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Password" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <PasswordBox Grid.Row="8" x:Name="pwdPassword"
                             Height="36" FontSize="14"
                             VerticalContentAlignment="Center" Padding="8,0"/>

                <Button Grid.Row="10"
                        Height="40" FontSize="14" FontWeight="SemiBold"
                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                        BorderThickness="0"
                        Click="BtnLogin_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowEnter20" FontSize="16" Margin="0,0,8,0" Foreground="White"/>
                        <TextBlock Text="Login"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
