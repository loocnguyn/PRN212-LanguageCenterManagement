<Window x:Class="WpfApp.RevenueReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revenue Report" Height="680" Width="1120"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="dpFrom" Width="130" Height="30"/>
            <TextBlock Text="To:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <DatePicker x:Name="dpTo" Width="130" Height="30"/>
            <TextBlock Text="Method:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox x:Name="cmbMethod" Width="120" Height="30">
                <ComboBoxItem Content="All" IsSelected="True"/>
                <ComboBoxItem Content="Cash"/>
                <ComboBoxItem Content="Transfer"/>
                <ComboBoxItem Content="Card"/>
            </ComboBox>
            <Button Content="Generate" Width="100" Height="30" Margin="10,0,0,0"
                    Click="BtnGenerate_Click"/>
            <Button Content="Clear" Width="80" Height="30" Margin="6,0,0,0"
                    Click="BtnClear_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Quick range:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="This Month" Width="100" Height="28" Margin="0,0,6,0"
                    Click="BtnThisMonth_Click"/>
            <Button Content="Last Month" Width="100" Height="28" Margin="0,0,6,0"
                    Click="BtnLastMonth_Click"/>
            <Button Content="This Quarter" Width="110" Height="28"
                    Click="BtnThisQuarter_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Summary" Padding="10" Margin="0,0,0,10">
            <UniformGrid Columns="5">
                <StackPanel>
                    <TextBlock Text="Total Revenue" FontWeight="Bold"/>
                    <TextBlock x:Name="lblTotalRevenue" Foreground="Green" FontSize="16"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Total Payments" FontWeight="Bold"/>
                    <TextBlock x:Name="lblTotalPayments" FontSize="16"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Cash" FontWeight="Bold"/>
                    <TextBlock x:Name="lblCashTotal" FontSize="16"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Transfer" FontWeight="Bold"/>
                    <TextBlock x:Name="lblTransferTotal" FontSize="16"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Card" FontWeight="Bold"/>
                    <TextBlock x:Name="lblCardTotal" FontSize="16"/>
                </StackPanel>
            </UniformGrid>
        </GroupBox>

        <DataGrid Grid.Row="3" x:Name="dgPayments"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Payment ID" Binding="{Binding PaymentId}" Width="80"/>
                <DataGridTextColumn Header="Invoice ID" Binding="{Binding InvoiceId}" Width="80"/>
                <DataGridTextColumn Header="Student ID" Binding="{Binding StudentId}" Width="80"/>
                <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="145"/>
                <DataGridTextColumn Header="Amount Paid" Binding="{Binding AmountPaid}" Width="110"/>
                <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="100"/>
                <DataGridTextColumn Header="Paid At" Binding="{Binding PaidAt}" Width="140"/>
                <DataGridTextColumn Header="Staff ID" Binding="{Binding StaffId}" Width="75"/>
                <DataGridTextColumn Header="Staff" Binding="{Binding StaffName}" Width="135"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
