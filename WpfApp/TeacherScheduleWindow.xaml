<Window x:Class="WpfApp.TeacherScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Schedule" Height="620" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: auto-loaded, no manual ID input -->
        <Border Grid.Row="0" Background="#F0F4F8" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="tbTeacherName" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text=" — " VerticalAlignment="Center" FontSize="14"/>
                <TextBlock x:Name="tbSemesterInfo" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Summary -->
        <TextBlock Grid.Row="1" x:Name="tbSummary" Margin="0,0,0,6" FontSize="12" Foreground="#555"/>

        <!-- DataGrid grouped by date -->
        <DataGrid Grid.Row="2" x:Name="dgSchedule"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold" FontSize="13" Margin="0,4"
                                       Text="{Binding Name, StringFormat='{}{0:dd/MM/yyyy (dddd)}'}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date"       Binding="{Binding SessionDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Day"        Binding="{Binding DayName}" Width="90"/>
                <DataGridTextColumn Header="Class"      Binding="{Binding ClassName}" Width="160"/>
                <DataGridTextColumn Header="Time"       Binding="{Binding TimeDisplay}" Width="110"/>
                <DataGridTextColumn Header="Room"       Binding="{Binding RoomName}" Width="110"/>
                <DataGridTextColumn Header="Course"     Binding="{Binding CourseName}" Width="140"/>
                <DataGridTextColumn Header="Status"     Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
    <Window.Resources>
        <CollectionViewSource x:Key="ScheduleViewSource">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="SessionDate"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
</Window>
