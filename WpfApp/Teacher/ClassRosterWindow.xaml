<Window x:Class="WpfApp.ClassRosterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="Class Roster" Height="640" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <local:InitialsConverter x:Key="Initials"/>

        <!-- Avatar bubble + name + email, the same student cell the staff screens use -->
        <DataTemplate x:Key="StudentCellTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="{StaticResource RoleStudentBrush}" Margin="0,0,12,0">
                    <TextBlock Text="{Binding FullName, Converter={StaticResource Initials}}"
                               Foreground="White" FontWeight="SemiBold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding Email}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource RoleTeacherBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PeopleTeam24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Class Roster" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="tbTeacherInfo" Foreground="#DDF3DD" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filters: semester -> course -> class -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Semester" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cboSemester" MinWidth="170" Height="34" DisplayMemberPath="Name"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CboSemester_SelectionChanged"/>

                    <TextBlock Text="Course" VerticalAlignment="Center" Margin="16,0,6,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cboCourse" MinWidth="200" Height="34" DisplayMemberPath="Name"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CboCourse_SelectionChanged"/>

                    <TextBlock Text="Class" VerticalAlignment="Center" Margin="16,0,6,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cboClass" MinWidth="200" Height="34" DisplayMemberPath="Name"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CboClass_SelectionChanged"/>

                    <Button Content="Reset" Style="{StaticResource PillButtonSubtle}" Width="84"
                            Margin="12,0,0,0" Click="BtnReset_Click"/>
                </StackPanel>
            </Border>

            <!-- Which class is on screen, and how full it is -->
            <Border Grid.Row="1" x:Name="classCard" Style="{StaticResource Card}" Padding="14,10"
                    Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="tbClassName" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="tbClassDetail" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Background="{StaticResource SecondaryLightBrush}">
                        <TextBlock x:Name="tbCount" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Roster -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgRoster" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="52" BorderThickness="0"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding StudentId}" Width="60"/>
                            <DataGridTemplateColumn Header="Student" Width="*"
                                                    CellTemplate="{StaticResource StudentCellTemplate}"/>
                            <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="90"/>
                            <DataGridTextColumn Header="Phone"  Binding="{Binding Phone}"  Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="emptyState" Text="Pick a class to see its students."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <ctl:PagerBar Grid.Row="3" x:Name="pager" HorizontalAlignment="Left"
                          Margin="0,12,0,0" PageChanged="Pager_PageChanged"/>
        </Grid>
    </DockPanel>
</Window>
