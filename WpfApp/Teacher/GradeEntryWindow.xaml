<Window x:Class="WpfApp.GradeEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grade Entry" Height="680" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="tbTeacherInfo" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
        <!-- Filter Panel: Semester -> Course -> Class -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Semester:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cboSemester" MinWidth="170" DisplayMemberPath="Name"
                      SelectionChanged="CboSemester_SelectionChanged" VerticalContentAlignment="Center"/>
            <TextBlock Text="Course:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="cboCourse" MinWidth="200" DisplayMemberPath="Name"
                      SelectionChanged="CboCourse_SelectionChanged" VerticalContentAlignment="Center"/>
            <TextBlock Text="Class:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="cboClass" MinWidth="200" DisplayMemberPath="Name" 
                      SelectionChanged="CboClass_SelectionChanged" VerticalContentAlignment="Center"/>
            <Button Content="Reset" Width="80" Height="28" Margin="6,0,0,0" Click="BtnReset_Click"/>
        </StackPanel>
        <DataGrid Grid.Row="2" x:Name="dgGrades"
                  AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single">
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save Grades" Width="130" Height="32" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>