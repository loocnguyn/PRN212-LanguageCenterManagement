<Window x:Class="WpfApp.GradeEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grade Entry" Height="620" Width="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="tbTeacherInfo" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
        <!-- Filter Panel: Semester -> Course -> Class -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Semester:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cboSemester" Width="170" Height="34" DisplayMemberPath="Name"
                      SelectionChanged="CboSemester_SelectionChanged" VerticalContentAlignment="Center"/>
            <TextBlock Text="Course:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="cboCourse" Width="200" Height="34" DisplayMemberPath="Name"
                      SelectionChanged="CboCourse_SelectionChanged" VerticalContentAlignment="Center"/>
            <TextBlock Text="Class:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="cboClass" Width="200" Height="34" DisplayMemberPath="Name" 
                      SelectionChanged="CboClass_SelectionChanged" VerticalContentAlignment="Center"/>
            <Button Content="Reset" Width="80" Height="28" Margin="6,0,0,0" Click="BtnReset_Click"/>
        </StackPanel>
        <DataGrid Grid.Row="2" x:Name="dgGrades"
                  AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student ID"   Binding="{Binding StudentId}"   Width="80"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}"  Width="170" IsReadOnly="True"/>
                <DataGridTextColumn Header="Component"    Binding="{Binding ComponentName}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Max"          Binding="{Binding MaxScore}"     Width="60"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Score"        Binding="{Binding Score}"        Width="80"/>
                <DataGridTextColumn Header="Note"         Binding="{Binding Note}"         Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save Grades" Width="130" Height="32" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>