<Window x:Class="WpfApp.AttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Attendance" Height="680" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Teacher Info + Filter Panel: Semester -> Course -> Class -> Session -->
        <Border Grid.Row="0" Background="#F0F4F8" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="tbTeacherName" Margin="0,0,0,6" FontSize="14" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Semester:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="cboSemester" MinWidth="180" DisplayMemberPath="Name"
                              SelectionChanged="CboSemester_SelectionChanged" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Course:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox x:Name="cboCourse" MinWidth="220" DisplayMemberPath="Name"
                              SelectionChanged="CboCourse_SelectionChanged" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Class:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="cboClass" MinWidth="220" DisplayMemberPath="Name"
                              SelectionChanged="CboClass_SelectionChanged" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Session Date:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox x:Name="cboSession" MinWidth="220" DisplayMemberPath="SessionDisplay"
                              SelectionChanged="CboSession_SelectionChanged" VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Summary -->
        <TextBlock Grid.Row="1" x:Name="tbSummary" Margin="0,0,0,6" FontSize="12" Foreground="#555"/>

        <!-- Attendance Grid -->
        <DataGrid Grid.Row="2" x:Name="dgAttendance"
                  AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student ID"   Binding="{Binding StudentId}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}" IsReadOnly="True" Width="180"/>
                <DataGridComboBoxColumn Header="Status"   SelectedItemBinding="{Binding Status}" Width="110">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="sys:String">
                            <sys:String>PRESENT</sys:String>
                            <sys:String>ABSENT</sys:String>
                            <sys:String>LATE</sys:String>
                            <sys:String>EXCUSED</sys:String>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save Attendance" Width="140" Height="32" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>