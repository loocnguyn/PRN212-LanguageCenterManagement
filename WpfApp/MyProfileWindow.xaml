<Window x:Class="WpfApp.MyProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Profile" Height="620" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="My Profile" FontSize="18" FontWeight="Bold"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbRoleBadge"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>

            <!-- Username (always visible, read-only) -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtUsername" Height="30"
                       VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,0,10" IsReadOnly="True"/>

            <!-- FullName (always visible, read-only) -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Full Name" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtFullName" Height="30"
                       VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,0,10" IsReadOnly="True"/>

            <!-- Phone (editable) -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Phone" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="txtPhone" Height="30"
                       VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,0,10"/>

            <!-- Email (editable) -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Email" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="txtEmail" Height="30"
                       VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,0,10"/>

            <!-- Student: Address -->
            <TextBlock Grid.Row="6" Grid.Column="0" x:Name="lblAddress" Text="Address" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>
            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="txtAddress" Height="30"
                       VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,0,10" Visibility="Collapsed"/>

            <!-- Student/Teacher: Gender -->
            <TextBlock Grid.Row="7" Grid.Column="0" x:Name="lblGender" Text="Gender" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>
            <ComboBox  Grid.Row="7" Grid.Column="1" x:Name="cmbGender" Height="30" Margin="0,0,0,10" Visibility="Collapsed">
                <ComboBoxItem Content="Male"/>
                <ComboBoxItem Content="Female"/>
            </ComboBox>

            <!-- Teacher: Specialization + Degree -->
            <TextBlock Grid.Row="8" Grid.Column="0" x:Name="lblSpec" Text="Specialization" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>
            <ComboBox  Grid.Row="8" Grid.Column="1" x:Name="cmbSpec" Height="30" Margin="0,0,0,10" Visibility="Collapsed">
                <ComboBoxItem Content="English"/>
                <ComboBoxItem Content="Japanese"/>
                <ComboBoxItem Content="Korean"/>
                <ComboBoxItem Content="Chinese"/>
                <ComboBoxItem Content="French"/>
                <ComboBoxItem Content="German"/>
            </ComboBox>

            <!-- Staff: Department -->
            <TextBlock Grid.Row="8" Grid.Column="0" x:Name="lblDept" Text="Department" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>
            <ComboBox  Grid.Row="8" Grid.Column="1" x:Name="cmbDept" Height="30" Margin="0,0,0,10" Visibility="Collapsed">
                <ComboBoxItem Content="Academic Affairs"/>
                <ComboBoxItem Content="Admissions"/>
                <ComboBoxItem Content="Finance"/>
                <ComboBoxItem Content="Human Resources"/>
            </ComboBox>

            <!-- Change password section -->
            <Border Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
            <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Change Password (optional)" FontWeight="SemiBold" Margin="0,10,0,10"/>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Old Password" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <PasswordBox Grid.Row="11" Grid.Column="1" x:Name="pwdOld" Height="30" Padding="4,0" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="12" Grid.Column="0" Text="New Password" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <PasswordBox Grid.Row="12" Grid.Column="1" x:Name="pwdNew" Height="30" Padding="4,0" Margin="0,0,0,10"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Save"   Width="90" Height="32" Margin="0,0,8,0" Click="BtnSave_Click"/>
                <Button Content="Cancel" Width="90" Height="32" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
