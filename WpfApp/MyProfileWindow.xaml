<Window x:Class="WpfApp.MyProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp"
        Title="My Profile" Height="600" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <local:InitialsConverter x:Key="Initials"/>
    </Window.Resources>

    <DockPanel>
        <!-- Role-colored header with avatar -->
        <Border x:Name="header" DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="60" Height="60" CornerRadius="30" Background="White" Margin="0,0,16,0">
                    <TextBlock x:Name="txtAvatar" Foreground="{StaticResource PrimaryBrush}"
                               Text="{Binding Text, ElementName=txtUsername, Converter={StaticResource Initials}}"
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text, ElementName=txtFullName}" Foreground="White"
                               FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Text, ElementName=txtUsername, StringFormat='@{0}'}"
                               Foreground="#EAF3FF" FontSize="13" Margin="0,2,0,0"/>
                    <Border CornerRadius="10" Padding="10,2" Background="#33FFFFFF"
                            HorizontalAlignment="Left" Margin="0,6,0,0">
                        <TextBlock x:Name="tbRoleBadge" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer buttons -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save"   Style="{StaticResource PillButton}"       Width="100" Margin="0,0,8,0" Click="BtnSave_Click"/>
                <Button Content="Cancel" Style="{StaticResource PillButtonSubtle}" Width="100" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Style="{StaticResource Card}" Margin="16">
            <TabControl BorderThickness="0" Background="Transparent">
                <TabItem Header="Profile Info">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Username (always visible, read-only) -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtUsername" Height="32"
                                   VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,10" IsReadOnly="True"/>

                        <!-- FullName (always visible, read-only) -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Full Name" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtFullName" Height="32"
                                   VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,10" IsReadOnly="True"/>

                        <!-- Phone (editable) -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtPhone" Height="32"
                                   VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,10"/>

                        <!-- Email (editable) -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Email" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtEmail" Height="32"
                                   VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,10"/>

                        <!-- Student: Address -->
                        <TextBlock Grid.Row="4" Grid.Column="0" x:Name="lblAddress" Text="Address" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="txtAddress" Height="32"
                                   VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,10" Visibility="Collapsed"/>

                        <!-- Student/Teacher/Staff: Gender -->
                        <TextBlock Grid.Row="5" Grid.Column="0" x:Name="lblGender" Text="Gender" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>
                        <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="cmbGender" Height="32" Margin="0,0,0,10" Visibility="Collapsed">
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                        </ComboBox>

                        <!-- Teacher: Specialization -->
                        <TextBlock Grid.Row="6" Grid.Column="0" x:Name="lblSpec" Text="Specialization" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>
                        <ComboBox  Grid.Row="6" Grid.Column="1" x:Name="cmbSpec" Height="32" Margin="0,0,0,10" Visibility="Collapsed">
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Japanese"/>
                            <ComboBoxItem Content="Korean"/>
                            <ComboBoxItem Content="Chinese"/>
                            <ComboBoxItem Content="French"/>
                            <ComboBoxItem Content="German"/>
                        </ComboBox>

                        <!-- Staff: Department -->
                        <TextBlock Grid.Row="6" Grid.Column="0" x:Name="lblDept" Text="Department" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>
                        <!-- Items populated from the Departments table at runtime -->
                        <ComboBox  Grid.Row="6" Grid.Column="1" x:Name="cmbDept" Height="32" Margin="0,0,0,10" Visibility="Collapsed"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Security">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="Change your password (leave blank to keep it unchanged)"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Old Password" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="pwdOld" Height="32" Padding="6,0" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="New Password" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="pwdNew" Height="32" Padding="6,0" Margin="0,0,0,10"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </DockPanel>
</Window>
