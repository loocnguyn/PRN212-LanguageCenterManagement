<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Language Center Management System"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="BookOpen24" Foreground="White" FontSize="20" Margin="0,0,10,0"/>
                <TextBlock Text="Language Center Management System"
                           Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Menu DockPanel.Dock="Top">

            <!-- ADMIN (all items), and STAFF/Academic (Student Management only) -->
            <MenuItem Header="Accounts" x:Name="menuAccounts" Visibility="Collapsed">
                <MenuItem.Icon><ui:SymbolIcon Symbol="PersonAccounts24"/></MenuItem.Icon>
                <MenuItem Header="Account Management"  x:Name="menuMiAccountManagement" Click="MenuAccountManagement_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="PersonEdit24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Student Management"  x:Name="menuMiStudentManagement" Click="MenuStudents_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="PeopleTeam24"/></MenuItem.Icon>
                </MenuItem>
                <!-- Teacher/Staff Management removed: Account Management (admin-only) already lists
                     every user with a role filter, using the same view/edit dialogs. Student
                     Management stays because academic staff reach it but not Account Management. -->
                <MenuItem Header="Departments"         x:Name="menuMiDepartments" Click="MenuDepartments_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Building24"/></MenuItem.Icon>
                </MenuItem>
                <Separator x:Name="menuAccountsSep"/>
                <MenuItem Header="Deactivated Accounts" x:Name="menuMiDeactivated" Click="MenuDeactivatedAccounts_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="PersonProhibited24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Semesters" x:Name="menuSemesters" Visibility="Collapsed">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Calendar24"/></MenuItem.Icon>
                <MenuItem Header="Semester Management" Click="MenuSemesters_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Calendar24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Courses" x:Name="menuCourses" Visibility="Collapsed">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Book24"/></MenuItem.Icon>
                <MenuItem Header="Course Management"   Click="MenuCourses_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Book24"/></MenuItem.Icon>
                </MenuItem>
                <!-- Languages and their levels — the catalogue courses are built from.
                     One screen: a level is meaningless outside its language. -->
                <MenuItem Header="Course Catalogue (Languages &amp; Levels)" Click="MenuCatalogue_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="LocalLanguage24"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Classroom Management" Click="MenuClassrooms_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Building24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Grading Structure" Click="MenuGradeTypeManagement_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="DocumentBulletList24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Classes" x:Name="menuClasses" Visibility="Collapsed">
                <MenuItem.Icon><ui:SymbolIcon Symbol="ClipboardTask24"/></MenuItem.Icon>
                <!-- Classes and enrollment now live inside a semester: Semesters ->
                     pick one -> Classes -> pick one -> Enrollments. A class cannot
                     exist without a semester, so there is no standalone entry point. -->
                <MenuItem Header="Classes &amp; Enrollment (via Semesters)" Click="MenuSemesters_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="CalendarLtr24"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Class Schedule Management" Click="MenuClassSchedules_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="CalendarLtr24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Slot Time Setting" Click="MenuSlotSetting_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Clock24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Session Room Change" Click="MenuSessionRoom_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Building24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- ADMIN, and STAFF (Finance department) -->
            <MenuItem Header="Finance" x:Name="menuFinance" Visibility="Collapsed">
                <MenuItem.Icon><ui:SymbolIcon Symbol="ReceiptMoney24"/></MenuItem.Icon>
                <MenuItem Header="Debt List"          Click="MenuDebtList_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="MoneyDismiss24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Invoice Management" Click="MenuInvoice_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Receipt24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Payment"            Click="MenuPayment_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Wallet24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Tuition Discounts" Click="MenuTuitionDiscounts_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="ReceiptMoney24"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Revenue Report" Click="MenuRevenueReport_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="DocumentBulletList24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- TEACHER only -->
            <MenuItem Header="Schedule" x:Name="menuTeacherSchedule" Visibility="Collapsed">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Calendar24"/></MenuItem.Icon>
                <MenuItem Header="My Schedule" Click="MenuTeacherSchedule_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Calendar24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Attendance" x:Name="menuTeacherAttendance" Visibility="Collapsed">
                <MenuItem.Icon><ui:SymbolIcon Symbol="PeopleCheckmark24"/></MenuItem.Icon>
                <MenuItem Header="Mark Attendance" Click="MenuAttendance_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="PeopleCheckmark24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Classes" x:Name="menuTeacherClasses" Visibility="Collapsed">
                <MenuItem.Icon><ui:SymbolIcon Symbol="ClipboardTask24"/></MenuItem.Icon>
                <MenuItem Header="Class Roster"  Click="MenuClassRoster_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="PeopleTeam24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Grade Entry"   Click="MenuGradeEntry_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="DocumentBulletList24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Class Results" Click="MenuClassResults_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="BookStar24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- STUDENT only -->
            <MenuItem Header="Schedule" x:Name="menuStudentSchedule" Visibility="Collapsed">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Calendar24"/></MenuItem.Icon>
                <MenuItem Header="My Schedule" Click="MenuStudentSchedule_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Calendar24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Attendance History" Click="MenuAttendanceHistory_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="CalendarClock24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Academics" x:Name="menuStudentAcademics" Visibility="Collapsed">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Book24"/></MenuItem.Icon>
                <MenuItem Header="My Classes" Click="MenuMyClasses_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Book24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="My Grades" Click="MenuMyGrades_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="DocumentBulletList24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Finance" x:Name="menuStudentFinance" Visibility="Collapsed">
                <MenuItem.Icon><ui:SymbolIcon Symbol="ReceiptMoney24"/></MenuItem.Icon>
                <MenuItem Header="My Invoices" Click="MenuMyInvoices_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Receipt24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="AI Assistant" x:Name="menuStudentAssistant" Visibility="Collapsed" Click="MenuAiAssistant_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Bot24"/></MenuItem.Icon>
            </MenuItem>

            <!-- ALL roles -->
            <MenuItem Header="System">
                <MenuItem.Icon><ui:SymbolIcon Symbol="SettingsChat24"/></MenuItem.Icon>
                <MenuItem Header="My Profile" Click="MenuMyProfile_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="PersonCircle24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Logout" Click="MenuLogout_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="DoorArrowLeft24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Background="{StaticResource BackgroundBrush}">
            <ContentControl x:Name="dashboardHost"/>
        </Grid>
    </DockPanel>
</Window>
