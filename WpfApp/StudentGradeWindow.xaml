<Window x:Class="WpfApp.StudentGradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Grades" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: student info -->
        <Border Grid.Row="0" Background="#F0F4F8" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <TextBlock x:Name="tbStudentInfo" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
        </Border>

        <!-- Summary and refresh button -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="tbSummary" VerticalAlignment="Center" FontSize="12" Foreground="#555" Margin="0,0,12,0"/>
            <Button Content="Refresh" Width="80" Height="28" Click="BtnRefresh_Click"/>
        </StackPanel>

        <!-- Grades DataGrid -->
        <DataGrid Grid.Row="2" x:Name="dgGrades"
                  AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="1" BorderBrush="LightGray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Semester"           Binding="{Binding SemesterName}"        Width="140"/>
                <DataGridTextColumn Header="Course"             Binding="{Binding CourseName}"         Width="140"/>
                <DataGridTextColumn Header="Class"              Binding="{Binding ClassName}"          Width="130"/>
                <DataGridTextColumn Header="Grade Type"         Binding="{Binding GradeTypeName}"      Width="120"/>
                <DataGridTextColumn Header="Score"              Binding="{Binding ScoreDisplay}"       Width="100" TextBlock.TextAlignment="Right"/>
                <DataGridTextColumn Header="Weight %"           Binding="{Binding WeightPercent}"      Width="100" TextBlock.TextAlignment="Right"/>
                <DataGridTextColumn Header="Graded At"          Binding="{Binding GradedAtDisplay}"    Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
