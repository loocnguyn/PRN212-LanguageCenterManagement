<Window x:Class="WpfApp.StudentInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Invoices" Height="560" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="tbStudentName" Text="Student:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,20,0"/>
            <TextBlock x:Name="tbBalance" Text="Wallet balance: 0 VND" VerticalAlignment="Center" FontWeight="Bold" Foreground="DarkGreen"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Top Up Wallet" Width="130" Height="28" Click="BtnTopUp_Click"/>
            <Button Content="Wallet History"      Width="110" Height="28" Margin="6,0,0,0" Click="BtnHistory_Click"/>
            <Button Content="Pay Tuition From Wallet" Width="150" Height="28" Margin="6,0,0,0" Click="BtnPayFromWallet_Click"/>
            <Button Content="Reset" Width="80" Height="28" Margin="6,0,0,0" Click="BtnReset_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="dgInvoices"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Invoice ID" Binding="{Binding InvoiceId}"  Width="90"/>
                <DataGridTextColumn Header="Amount"     Binding="{Binding Amount}"      Width="110"/>
                <DataGridTextColumn Header="Paid"       Binding="{Binding PaidAmount}"  Width="110"/>
                <DataGridTextColumn Header="Due Date"   Binding="{Binding DueDate}"     Width="110"/>
                <DataGridTextColumn Header="Status"     Binding="{Binding Status}"      Width="100"/>
                <DataGridTextColumn Header="Note"       Binding="{Binding Note}"        Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
