<Window x:Class="WpfApp.CourseGradingStructureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Grading Structure" Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel>
        <!-- Header band names the course being configured -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="DocumentBulletList24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="tbCourseName" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="tbCourseCode" Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Total weight indicator -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total weight" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbStatus" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" x:Name="pbWeight" Height="16" Maximum="100" Value="0"
                                 Margin="0,10,0,0" Foreground="{StaticResource SecondaryBrush}"
                                 Background="{StaticResource BackgroundBrush}" BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- Grade components -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgGradeTypes" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" BorderThickness="0" Background="Transparent" RowHeight="42"
                              MouseDoubleClick="DgGradeTypes_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Component" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="Weight" Binding="{Binding WeightPercent, StringFormat='{}{0:0.##}%'}" Width="100"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="44"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No grade components yet" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="Add components (e.g. Attendance, Midterm, Final) totalling 100%."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Add"    Style="{StaticResource PillButton}"        Width="90" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                <Button Content="Edit"   Style="{StaticResource PillButtonSuccess}" Width="90" Margin="0,0,8,0" Click="BtnEdit_Click"/>
                <Button Content="Delete" Style="{StaticResource PillButtonDanger}"  Width="90" Margin="0,0,8,0" Click="BtnDelete_Click"/>
                <Button Content="Close"  Style="{StaticResource PillButtonSubtle}"  Width="90" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
