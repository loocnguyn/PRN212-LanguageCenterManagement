<Window x:Class="WpfApp.ClassScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Class Schedule" Height="540" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="CalendarLtr24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="tbClassName" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Weekly sessions for this class" Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- How many meetings this weekly pattern actually delivers inside the
                 semester, against the number the course requires. -->
            <Border Grid.Row="0" x:Name="coverageCard" Style="{StaticResource Card}"
                    Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Sessions covered"
                               FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbCoverage"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="tbCoverageHint"
                               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="dgSchedules" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" BorderThickness="0" Background="Transparent" RowHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Day" Binding="{Binding DayName}" Width="*"/>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartTimeStr}" Width="140"/>
                        <DataGridTextColumn Header="End" Binding="{Binding EndTimeStr}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Add Session" Style="{StaticResource PillButton}"       Width="120" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                <Button Content="Delete"      Style="{StaticResource PillButtonDanger}" Width="90"  Margin="0,0,8,0" Click="BtnDelete_Click"/>
                <Button Content="Close"       Style="{StaticResource PillButtonSubtle}" Width="90"  Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
