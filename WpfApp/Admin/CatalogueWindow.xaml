<Window x:Class="WpfApp.CatalogueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Course Catalogue" Height="700" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="LocalLanguage24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Course Catalogue" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="The languages the centre teaches, and the levels of each — courses are built from these"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Master: languages, with their own actions underneath -->
            <DockPanel Grid.Column="0" Margin="0,0,14,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Add"    Style="{StaticResource PillButton}"        Width="80" Margin="0,0,6,0" Click="BtnAddLanguage_Click"/>
                    <Button Content="Edit"   Style="{StaticResource PillButtonSuccess}" Width="80" Margin="0,0,6,0" Click="BtnEditLanguage_Click"/>
                    <Button Content="Delete" Style="{StaticResource PillButtonDanger}"  Width="80" Click="BtnDeleteLanguage_Click"/>
                </StackPanel>

                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource BackgroundBrush}" Padding="12,10">
                            <TextBlock Text="Languages" FontWeight="SemiBold" FontSize="13"/>
                        </Border>
                        <ListBox x:Name="lstLanguages" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="LstLanguages_SelectionChanged"
                                 MouseDoubleClick="LstLanguages_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- Detail: that language's levels -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="tbLanguageName" FontSize="16" FontWeight="SemiBold"
                                   Text="Select a language"/>
                        <TextBlock x:Name="tbLanguageHint" FontSize="12" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Its levels will appear below."/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <DataGrid x:Name="dgLevels" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" RowHeight="44" BorderThickness="0"
                                  Background="Transparent" MouseDoubleClick="DgLevels_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding LevelId}" Width="70"/>
                                <DataGridTextColumn Header="Level" Binding="{Binding Name}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Courses" Binding="{Binding CourseCount}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <ui:SymbolIcon Symbol="ArrowSortUp24" FontSize="40"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No levels for this language yet"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,2"/>
                            <TextBlock Text="Click Add level to define one."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Add level" Style="{StaticResource PillButton}"        Width="110" Margin="0,0,8,0" Click="BtnAddLevel_Click"/>
                    <Button Content="Edit"      Style="{StaticResource PillButtonSuccess}" Width="90"  Margin="0,0,8,0" Click="BtnEditLevel_Click"/>
                    <Button Content="Delete"    Style="{StaticResource PillButtonDanger}"  Width="90"  Click="BtnDeleteLevel_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
