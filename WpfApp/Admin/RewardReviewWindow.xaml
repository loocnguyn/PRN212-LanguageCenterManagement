<Window x:Class="WpfApp.RewardReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Scholarship Review" Height="660" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Status badge: Eligible (green), Rewarded (teal), — (grey) -->
        <DataTemplate x:Key="RewardStatusTemplate">
            <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource TextSecondaryBrush}">
                <TextBlock Text="{Binding StatusDisplay}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusDisplay}" Value="Eligible">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusDisplay}" Value="Rewarded">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="BookStar24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Scholarship Review" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Rank a course's students and reward top performers with a tuition voucher"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filter / parameters -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Semester:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="cboSemester" Width="180" Height="32" DisplayMemberPath="Name" SelectedValuePath="SemesterId"/>
                    <TextBlock Text="Course:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox x:Name="cboCourse" Width="200" Height="32" DisplayMemberPath="Name" SelectedValuePath="CourseId"/>
                    <TextBlock Text="Threshold:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <TextBox x:Name="txtThreshold" Width="56" Height="32" Text="8.0" VerticalContentAlignment="Center" Padding="6,0"/>
                    <Button Content="Review" Style="{StaticResource PillButton}" Width="90" Margin="16,0,0,0" Click="BtnReview_Click"/>
                </StackPanel>
            </Border>

            <!-- Ranked candidates -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgCandidates" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" BorderThickness="0" Background="Transparent" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="50"/>
                            <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="140"/>
                            <DataGridTextColumn Header="Weighted avg" Binding="{Binding AverageDisplay}" Width="130"/>
                            <DataGridTemplateColumn Header="Status" Width="130" CellTemplate="{StaticResource RewardStatusTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="emptyState" Text="Pick a semester and course, then click Review."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Grant controls -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="tbSummary" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Discount %:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtDiscount" Width="56" Height="32" Text="10" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,12,0"/>
                    <TextBlock Text="Valid (days):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtValidDays" Width="56" Height="32" Text="90" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,12,0"/>
                    <Button x:Name="btnGrant" Content="Grant Vouchers" Style="{StaticResource PillButtonSuccess}"
                            Width="150" Click="BtnGrant_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
