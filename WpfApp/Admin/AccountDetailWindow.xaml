<Window x:Class="WpfApp.AccountDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add Account" Height="640" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel>
        <!-- Header band -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PersonEdit24" Foreground="White" FontSize="24" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Account Details" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Set the role, credentials and profile for this account"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer actions -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save"   Style="{StaticResource PillButton}"       Width="100" Margin="0,0,8,0" Click="BtnSave_Click"/>
                <Button Content="Cancel" Style="{StaticResource PillButtonSubtle}" Width="100" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Role -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Role" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cmbRole" Margin="0,0,0,12"
                               SelectionChanged="CmbRole_SelectionChanged">
                        <ComboBoxItem Content="STAFF"/>
                        <ComboBoxItem Content="TEACHER"/>
                        <ComboBoxItem Content="STUDENT"/>
                    </ComboBox>

                    <!-- Username -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtUsername" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                    <!-- Password -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="pwdPassword" Height="34" Padding="8,0" Margin="0,0,0,4"
                                 VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="lblPasswordHint"
                               Text="(leave blank to keep current password)" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" Visibility="Collapsed"/>

                    <!-- FullName -->
                    <TextBlock Grid.Row="4" Grid.Column="0" x:Name="lblFullName" Text="Họ tên" VerticalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="txtFullName" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12" Visibility="Collapsed"/>

                    <!-- Phone -->
                    <TextBlock Grid.Row="5" Grid.Column="0" x:Name="lblPhone" Text="Phone" VerticalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" x:Name="txtPhone" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12" Visibility="Collapsed"/>

                    <!-- Email -->
                    <TextBlock Grid.Row="6" Grid.Column="0" x:Name="lblEmail" Text="Email" VerticalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" x:Name="txtEmail" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12" Visibility="Collapsed"/>

                    <!-- Student: Date of Birth -->
                    <TextBlock Grid.Row="7" Grid.Column="0" x:Name="lblDob" Text="Ngày sinh" VerticalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>
                    <DatePicker Grid.Row="7" Grid.Column="1" x:Name="dpDob" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center" Visibility="Collapsed"/>

                    <!-- Student/Teacher: Gender -->
                    <TextBlock Grid.Row="8" Grid.Column="0" x:Name="lblGender" Text="Giới tính" VerticalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>
                    <ComboBox  Grid.Row="8" Grid.Column="1" x:Name="cmbGender" Margin="0,0,0,12" Visibility="Collapsed">
                        <ComboBoxItem Content="Male"/>
                        <ComboBoxItem Content="Female"/>
                    </ComboBox>

                    <!-- Teacher: Specialization -->
                    <TextBlock Grid.Row="9" Grid.Column="0" x:Name="lblSpec" Text="Specialization" VerticalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>
                    <ComboBox  Grid.Row="9" Grid.Column="1" x:Name="txtSpec" Margin="0,0,0,12" Visibility="Collapsed">
                        <ComboBoxItem Content="English"/>
                        <ComboBoxItem Content="Japanese"/>
                        <ComboBoxItem Content="Korean"/>
                        <ComboBoxItem Content="Chinese"/>
                        <ComboBoxItem Content="French"/>
                        <ComboBoxItem Content="German"/>
                    </ComboBox>

                    <!-- Teacher: Degree -->
                    <TextBlock Grid.Row="10" Grid.Column="0" x:Name="lblDegree" Text="Bằng cấp" VerticalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>
                    <ComboBox  Grid.Row="10" Grid.Column="1" x:Name="cmbDegree" Margin="0,0,0,12" Visibility="Collapsed">
                        <ComboBoxItem Content="Bachelor"/>
                        <ComboBoxItem Content="Master"/>
                        <ComboBoxItem Content="Doctor"/>
                    </ComboBox>

                    <!-- Staff: Department (populated from the Departments table at runtime) -->
                    <TextBlock Grid.Row="9" Grid.Column="0" x:Name="lblDept" Text="Department" VerticalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>
                    <ComboBox  Grid.Row="9" Grid.Column="1" x:Name="txtDept" Margin="0,0,0,12" Visibility="Collapsed"/>

                    <!-- Active (edit only) -->
                    <TextBlock Grid.Row="10" Grid.Column="0" x:Name="lblActive" Text="Active" VerticalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>
                    <CheckBox  Grid.Row="10" Grid.Column="1" x:Name="chkActive" VerticalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
