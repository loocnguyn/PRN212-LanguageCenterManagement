<Window x:Class="WpfApp.CourseDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add Course" Height="620" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Book24" Foreground="White" FontSize="24" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="tbTitle" Text="New Course" Foreground="White"
                               FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Pick a language, then one of its levels"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Code" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtCode" Height="34" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtName" Height="34" Margin="0,0,0,10"/>

                <!-- Language drives the Level list below -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Language" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbLanguage" Margin="0,0,0,10"
                          DisplayMemberPath="Name" SelectedValuePath="LanguageId"
                          SelectionChanged="CmbLanguage_SelectionChanged"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Level" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                    <ComboBox x:Name="cmbLevel"
                              DisplayMemberPath="Name" SelectedValuePath="LevelId"/>
                    <TextBlock x:Name="tbLevelHint" FontSize="11" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Pick a language first."/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Duration (sessions)" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtDuration" Height="34" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Tuition fee" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtFee" Height="34" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Description" VerticalAlignment="Top" Margin="0,6,0,10"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtDescription" Height="80"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" Padding="6,6" Margin="0,0,0,10"/>

                <!-- Only shown when editing: a new course is always created active. -->
                <TextBlock x:Name="lblActive" Grid.Row="7" Grid.Column="0" Text="Active"
                           VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>
                <CheckBox x:Name="chkActive" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center"
                          Margin="0,0,0,10" IsChecked="True" Visibility="Collapsed"/>

                <StackPanel Grid.Row="8" Grid.ColumnSpan="2"
                            Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Save"   Style="{StaticResource PillButton}"       Width="90" Margin="0,0,8,0" Click="BtnSave_Click"/>
                    <Button Content="Cancel" Style="{StaticResource PillButtonSubtle}" Width="90" Click="BtnCancel_Click"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
