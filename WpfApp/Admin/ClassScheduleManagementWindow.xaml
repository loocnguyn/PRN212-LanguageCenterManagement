<Window x:Class="WpfApp.ClassScheduleManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Class Schedule Management" Height="660" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="CalendarLtr24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Class Schedule Management" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Set the weekly timetable for each class"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Class:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="cboClassFilter" Width="220" Height="32" VerticalContentAlignment="Center"
                              DisplayMemberPath="Name" SelectedValuePath="ClassId"
                              SelectionChanged="CboClassFilter_SelectionChanged"/>
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <TextBox x:Name="txtSearch" Width="220" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                    <Button Content="Search" Style="{StaticResource PillButton}" Width="84" Margin="8,0,0,0" Click="BtnSearch_Click"/>
                    <Button Content="Reset" Style="{StaticResource PillButtonSubtle}" Width="84" Margin="8,0,0,0" Click="BtnReset_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="dgSchedules" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" BorderThickness="0" Background="Transparent" RowHeight="40"
                          SelectionChanged="DgSchedules_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ScheduleId}" Width="50"/>
                        <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="180"/>
                        <DataGridTextColumn Header="Day" Binding="{Binding DayName}" Width="140"/>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartTimeStr}" Width="120"/>
                        <DataGridTextColumn Header="End" Binding="{Binding EndTimeStr}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Add"    Style="{StaticResource PillButton}"        Width="90" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                <Button Content="Edit"   Style="{StaticResource PillButtonSuccess}" Width="90" Margin="0,0,8,0" Click="BtnEdit_Click"/>
                <Button Content="Delete" Style="{StaticResource PillButtonDanger}"  Width="90" Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
