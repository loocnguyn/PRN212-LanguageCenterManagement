<Window x:Class="WpfApp.ClassEnrollmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="Class Enrollment" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate x:Key="EnrollStatusTemplate">
            <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource SecondaryBrush}">
                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="DROPPED">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="LOCKED">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="StudentCellTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{Binding StudentIdDisplay}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PersonAdd24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="tbTitle" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="tbSubtitle" Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Capacity + the price this class charges -->
            <UniformGrid Grid.Row="0" Rows="1" Columns="3" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="statEnrolled" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Enrolled" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="statSeats" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryBrush}"/>
                        <TextBlock Text="Seats left" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="statFee" Text="0 đ" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Tuition (frozen)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Enrol into THIS class. Picking happens in StudentPickerDialog: it lists who is
                 actually enrollable and carries the per-student discount, which a single ID
                 box could not express. -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add students…" Style="{StaticResource PillButton}" Width="150"
                            Click="BtnEnroll_Click"/>
                    <Button Content="Refresh" Style="{StaticResource PillButtonSubtle}" Width="90"
                            Margin="8,0,0,0" Click="BtnRefresh_Click"/>
                    <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Choose students from a list and set each one's discount."/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgEnrollments" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="48" BorderThickness="0"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding EnrollmentId}" Width="60"/>
                            <DataGridTemplateColumn Header="Student" Width="*" CellTemplate="{StaticResource StudentCellTemplate}"/>
                            <DataGridTextColumn Header="Enrolled"
                                                Binding="{Binding EnrolledDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="130"/>
                            <DataGridTemplateColumn Header="Status" Width="130" CellTemplate="{StaticResource EnrollStatusTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="PersonAdd24" FontSize="44"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nobody enrolled yet" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="Click &quot;Add students…&quot; above to enrol them."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <ctl:PagerBar x:Name="pager" HorizontalAlignment="Left" PageChanged="Pager_PageChanged"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Drop" Style="{StaticResource PillButtonDanger}" Width="90" Click="BtnDrop_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
