<Window x:Class="WpfApp.DeactivatedAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="Deactivated Accounts" Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <local:InitialsConverter x:Key="Initials"/>

        <DataTemplate x:Key="RoleBadgeTemplate">
            <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource RoleStaffBrush}">
                <TextBlock Text="{Binding Role}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="ADMIN">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource RoleAdminBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="TEACHER">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource RoleTeacherBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="STUDENT">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource RoleStudentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Avatar is greyed out to reinforce the "deactivated" state -->
        <DataTemplate x:Key="AccountCellTemplate">
            <StackPanel Orientation="Horizontal" Opacity="0.75">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Initials, Converter={StaticResource Initials}}"
                               Foreground="White" FontWeight="SemiBold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding Email}"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource TextSecondaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PersonProhibited24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Deactivated Accounts" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Reactivate accounts that were previously disabled"
                               Foreground="#E6E6E6" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgUsers" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="52" BorderThickness="0"
                              Background="Transparent" MouseDoubleClick="DgUsers_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Account" Width="*" CellTemplate="{StaticResource AccountCellTemplate}"/>
                            <DataGridTemplateColumn Header="Role" Width="140" CellTemplate="{StaticResource RoleBadgeTemplate}"/>
                            <DataGridTextColumn Header="Created At"
                                                Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="46"
                                       Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No deactivated accounts" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="Every account is currently active." FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer: pager + actions -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <ctl:PagerBar x:Name="pager" HorizontalAlignment="Left" PageChanged="Pager_PageChanged"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Activate" Style="{StaticResource PillButtonSuccess}" Width="110" Click="BtnActivate_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
