<Window x:Class="WpfApp.TopStudentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="Top Students" Height="660" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <local:InitialsConverter x:Key="Initials"/>

        <DataTemplate x:Key="StudentCellTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="17"
                        Background="{StaticResource RoleStudentBrush}" Margin="0,0,12,0">
                    <TextBlock Text="{Binding StudentName, Converter={StaticResource Initials}}"
                               Foreground="White" FontWeight="SemiBold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{Binding StudentEmail}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- The average, with how complete it is underneath. A 9.2 over 40% of the
             weights is not the same claim as a 9.2 over all of them. -->
        <DataTemplate x:Key="AverageCellTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="avg" Text="{Binding AverageDisplay}" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding ProgressDisplay}" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding MeetsThreshold}" Value="True">
                    <Setter TargetName="avg" Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Already paid, and how much. A dash rather than a blank so the column
             reads as answered rather than as missing. -->
        <DataTemplate x:Key="AwardCellTemplate">
            <Border x:Name="tag" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left"
                    Background="Transparent" VerticalAlignment="Center">
                <TextBlock x:Name="txt" Text="{Binding AwardDisplay}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAwarded}" Value="True">
                    <Setter TargetName="tag" Property="Background" Value="{StaticResource SecondaryLightBrush}"/>
                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
                    <Setter TargetName="txt" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="BookStar24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Top Students" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Rank a semester's students by weighted average and see who clears a mark"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filters -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Semester" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cboSemester" MinWidth="170" Height="34" DisplayMemberPath="Name"
                              SelectedValuePath="SemesterId" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Average at least" VerticalAlignment="Center" Margin="16,0,6,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="txtThreshold" Width="56" Height="34" Text="8.0"
                             VerticalContentAlignment="Center" Padding="6,0"/>

                    <Button Content="Show" Style="{StaticResource PillButton}" Width="90"
                            Margin="16,0,0,0" Click="BtnShow_Click"/>

                    <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11"
                               TextWrapping="Wrap" MaxWidth="260"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Students still missing a component are left out — a partial average is not comparable with a finished one."/>
                </StackPanel>
            </Border>

            <!-- Counts -->
            <StackPanel Grid.Row="1" x:Name="summaryPanel" Orientation="Horizontal"
                        Margin="0,0,0,12" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0" MinWidth="140">
                    <StackPanel>
                        <TextBlock x:Name="statTotal" Text="0" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="students taking it" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0" MinWidth="140">
                    <StackPanel>
                        <TextBlock x:Name="statAbove" Text="0" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryBrush}"/>
                        <TextBlock x:Name="statAboveLabel" Text="clear the mark" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,10" MinWidth="140">
                    <StackPanel>
                        <TextBlock x:Name="statPending" Text="0" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="not fully marked yet" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Ranking -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgRanking" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="50" BorderThickness="0"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <!-- The only editable column. A row already paid has its box
                                 disabled rather than hidden, so it still reads as a row
                                 that was eligible. -->
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanBeAwarded}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="50"/>
                            <DataGridTemplateColumn Header="Student" Width="*"
                                                    CellTemplate="{StaticResource StudentCellTemplate}"/>
                            <DataGridTextColumn Header="Class"  Binding="{Binding ClassName}"  Width="130"/>
                            <DataGridTextColumn Header="Course" Binding="{Binding CourseName}" Width="170"/>
                            <DataGridTemplateColumn Header="Weighted average" Width="150"
                                                    CellTemplate="{StaticResource AverageCellTemplate}"/>
                            <DataGridTemplateColumn Header="Awarded" Width="110"
                                                    CellTemplate="{StaticResource AwardCellTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="emptyState" TextAlignment="Center"
                               Text="Pick a semester, then press Show."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Awarding. Deliberately below the grid and behind a confirmation:
                 it is the one thing on this screen that cannot be undone. -->
            <Border Grid.Row="3" x:Name="awardBar" Style="{StaticResource Card}" Padding="12"
                    Margin="0,12,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <ctl:PagerBar x:Name="pager" VerticalAlignment="Center"
                                      PageChanged="Pager_PageChanged"/>

                        <Button Content="Tick all shown" Style="{StaticResource PillButtonSubtle}" Width="120"
                                Margin="16,0,0,0" Click="BtnTickAll_Click"/>
                        <Button Content="Clear ticks" Style="{StaticResource PillButtonSubtle}" Width="100"
                                Margin="8,0,0,0" Click="BtnClearTicks_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Award each" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="txtAmount" Width="110" Height="34" Text="500000"
                                 VerticalContentAlignment="Center" Padding="6,0"/>
                        <TextBlock Text="đ" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Text="Reason" VerticalAlignment="Center" Margin="16,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="txtNote" Width="240" Height="34"
                                 VerticalContentAlignment="Center" Padding="6,0"/>

                        <TextBlock x:Name="tbTicked" VerticalAlignment="Center" Margin="16,0,0,0"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>

                        <Button Content="Award selected" Style="{StaticResource PillButton}" Width="150"
                                Margin="16,0,0,0" Click="BtnAward_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
