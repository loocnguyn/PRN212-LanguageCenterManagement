<Window x:Class="WpfApp.SemesterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Semester" Height="470" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="CalendarLtr24" Foreground="White" FontSize="24" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="tbTitle" Text="New Semester" Foreground="White"
                               FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Semesters must not overlap each other"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,8"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtName" Height="34"
                     VerticalContentAlignment="Center" Padding="6,0" Margin="0,6"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Start date" VerticalAlignment="Center" Margin="0,8"/>
            <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dpStartDate" Height="34" Margin="0,6"
                        SelectedDateChanged="Dates_Changed"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Setup ends" VerticalAlignment="Center" Margin="0,8"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6">
                <DatePicker x:Name="dpSetupEndDate" Height="34" SelectedDateChanged="Dates_Changed"/>
                <TextBlock Text="Last day of setup — teaching starts the next day"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="End date" VerticalAlignment="Center" Margin="0,8"/>
            <DatePicker Grid.Row="3" Grid.Column="1" x:Name="dpEndDate" Height="34" Margin="0,6"
                        SelectedDateChanged="Dates_Changed"/>

            <!-- Live summary of the phases the chosen dates produce -->
            <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Card}"
                    Padding="12" Margin="0,14,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Timeline" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock x:Name="tbPreview" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Pick a start and end date."/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Save"   Style="{StaticResource PillButton}"       Width="90" Margin="0,0,8,0" Click="BtnSave_Click"/>
                <Button Content="Cancel" Style="{StaticResource PillButtonSubtle}" Width="90" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
