<Window x:Class="WpfApp.CourseManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Course Management" Height="660" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Active / inactive status badge -->
        <DataTemplate x:Key="StatusBadgeTemplate">
            <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource SecondaryBrush}">
                <TextBlock x:Name="txt" Text="Active" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter TargetName="txt" Property="Text" Value="Inactive"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Book24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Course Management" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Create and manage courses, levels and tuition fees"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtSearch" Width="260" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                    <Button Content="Search" Style="{StaticResource PillButton}" Width="84" Margin="8,0,0,0" Click="BtnSearch_Click"/>
                    <Button Content="Reset" Style="{StaticResource PillButtonSubtle}" Width="84" Margin="8,0,0,0" Click="BtnReset_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="dgCourses" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" BorderThickness="0" Background="Transparent" RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding CourseId}" Width="50"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80"/>
                        <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="110"/>
                        <DataGridTextColumn Header="Sessions" Binding="{Binding DurationSessions}" Width="90"/>
                        <DataGridTextColumn Header="Fee" Binding="{Binding TuitionFee, StringFormat='{}{0:N0} đ'}" Width="130"/>
                        <DataGridTemplateColumn Header="Status" Width="110" CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Add"    Style="{StaticResource PillButton}"        Width="90" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                <Button Content="Edit"   Style="{StaticResource PillButtonSuccess}" Width="90" Margin="0,0,8,0" Click="BtnEdit_Click"/>
                <Button Content="Delete" Style="{StaticResource PillButtonDanger}"  Width="90" Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
