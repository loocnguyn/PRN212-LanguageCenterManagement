<Window x:Class="WpfApp.StudentPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add Students" Height="660" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PeopleAdd24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="tbTitle" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="tbSubtitle" Foreground="#DCEBFF" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#33FFFFFF" CornerRadius="12" Padding="12,4">
                    <TextBlock x:Name="tbSeats" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="16"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="txtSearch" Height="34"
                             TextChanged="TxtSearch_TextChanged"
                             ToolTip="Search by name, phone or email"/>
                </Grid>
            </Border>

            <!-- Bulk helper: writes the chosen discount onto every ticked row. It is a
                 shortcut, not a constraint — each row can still be changed afterwards. -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Apply to all ticked:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cboBulkDiscount" MinWidth="300" DisplayMemberPath="DisplayText"/>
                    <Button Content="Apply" Style="{StaticResource PillButtonSubtle}" Width="90"
                            Margin="10,0,0,0" Click="BtnApplyAll_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ListBox x:Name="lstStudents" BorderThickness="0" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold"/>
                                            <!-- Enrolling this person revives their old row rather than
                                                 adding a second one — worth saying out loud. -->
                                            <Border CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                                                    Background="{StaticResource TextSecondaryBrush}"
                                                    Visibility="{Binding DroppedVisibility}">
                                                <TextBlock Text="previously dropped" Foreground="White" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                        <ComboBox Width="210"
                                                  ItemsSource="{Binding DiscountOptions}"
                                                  DisplayMemberPath="DisplayText"
                                                  SelectedValuePath="DiscountId"
                                                  SelectedValue="{Binding DiscountId, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsSelected}"/>
                                        <TextBlock Text="{Binding DiscountHint}" FontSize="10" Margin="2,2,0,0"
                                                   Foreground="{StaticResource InfoBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding PriceText}" Width="120"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="PeopleProhibited24" FontSize="44"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="tbEmpty" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock x:Name="tbEmptyHint" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="tbSelected" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="tbTotal" FontSize="13" Margin="16,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource PillButtonSubtle}" Width="100"
                            Margin="0,0,8,0" Click="BtnCancel_Click"/>
                    <Button x:Name="btnEnroll" Content="Enroll" Style="{StaticResource PillButton}" Width="140"
                            Click="BtnEnroll_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
