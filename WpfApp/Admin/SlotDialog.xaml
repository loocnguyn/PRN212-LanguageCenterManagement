<Window x:Class="WpfApp.SlotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slot" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="tbTitle" Text="Add slot"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Slot number" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtSlotNo" Height="32"
                   VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Start (HH:mm)" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtStart" Height="32"
                   VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="End (HH:mm)" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtEnd" Height="32"
                   VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save"   Style="{StaticResource PillButton}"       Width="90" Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button Content="Cancel" Style="{StaticResource PillButtonSubtle}" Width="90" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
