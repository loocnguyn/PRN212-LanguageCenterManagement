<Window x:Class="WpfApp.SemesterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Semester Management" Height="620" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input Form -->
        <GroupBox Grid.Row="0" Header="Semester Details" Margin="0,0,0,8" Padding="8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Name:" Margin="0,0,0,2"/>
                    <TextBox x:Name="txtName" Width="230" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Start Date:" Margin="0,0,0,2"/>
                    <DatePicker x:Name="dpStartDate" Width="140" Height="28" SelectedDateChanged="DpStartDate_SelectedDateChanged"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Setup End Date:" Margin="0,0,0,2"/>
                    <DatePicker x:Name="dpSetupEndDate" Width="140" Height="28"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="End Date:" Margin="0,0,0,2"/>
                    <DatePicker x:Name="dpEndDate" Width="140" Height="28"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <CheckBox x:Name="chkActive" Content="Active" VerticalAlignment="Bottom" Height="28"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" x:Name="dgSemesters"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="DgSemesters_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding SemesterId}" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
                <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                <DataGridTextColumn Header="Setup End Date" Binding="{Binding SetupEndDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                <DataGridTextColumn Header="Is Active" Binding="{Binding IsActive}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Add" Width="90" Height="32" Margin="0,0,8,0" Click="BtnAdd_Click"/>
            <Button Content="Edit" Width="90" Height="32" Margin="0,0,8,0" Click="BtnEdit_Click"/>
            <Button Content="Delete" Width="90" Height="32" Margin="0,0,8,0" Click="BtnDelete_Click"/>
            <Button Content="Set Active" Width="90" Height="32" Click="BtnSetActive_Click"/>
        </StackPanel>
    </Grid>
</Window>
