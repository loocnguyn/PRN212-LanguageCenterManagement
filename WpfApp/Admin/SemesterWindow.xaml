<Window x:Class="WpfApp.SemesterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="Semester Management" Height="680" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Derived from the dates: Upcoming / Setup / Teaching / Completed -->
        <DataTemplate x:Key="SemesterStatusTemplate">
            <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource TextSecondaryBrush}">
                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Setup">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Teaching">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Upcoming">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SemesterCellTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="{Binding RangeText}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="CalendarLtr24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Semester Management" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="The current semester is whichever one contains today — no manual switch"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Which semester is current right now -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon x:Name="iconCurrent" Symbol="CalendarClock24" FontSize="20"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                    <TextBlock Text="Current semester" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="tbCurrent" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Border x:Name="phaseBadge" CornerRadius="10" Padding="10,3" Margin="12,0,0,0"
                            VerticalAlignment="Center" Background="{StaticResource SecondaryBrush}">
                        <TextBlock x:Name="tbPhase" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgSemesters" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="52" BorderThickness="0"
                              Background="Transparent" MouseDoubleClick="DgSemesters_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Semester" Width="*" CellTemplate="{StaticResource SemesterCellTemplate}"/>
                            <DataGridTextColumn Header="Setup ends"
                                                Binding="{Binding SetupEndDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="130"/>
                            <DataGridTextColumn Header="Teaching from"
                                                Binding="{Binding TeachingFrom, StringFormat='{}{0:dd/MM/yyyy}'}" Width="130"/>
                            <DataGridTextColumn Header="Classes" Binding="{Binding ClassCount}" Width="90"/>
                            <DataGridTemplateColumn Header="Status" Width="140" CellTemplate="{StaticResource SemesterStatusTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="CalendarAdd24" FontSize="44"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No semesters yet" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="Click Add to create the first one."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer: pager + actions -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <ctl:PagerBar x:Name="pager" HorizontalAlignment="Left" PageChanged="Pager_PageChanged"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Classes" Style="{StaticResource PillButtonInfo}"    Width="110" Margin="0,0,8,0" Click="BtnClasses_Click"/>
                    <Button Content="Add"     Style="{StaticResource PillButton}"        Width="90"  Margin="0,0,8,0" Click="BtnAdd_Click"/>
                    <Button Content="Edit"    Style="{StaticResource PillButtonSuccess}" Width="90"  Margin="0,0,8,0" Click="BtnEdit_Click"/>
                    <Button Content="Delete"  Style="{StaticResource PillButtonDanger}"  Width="90"  Click="BtnDelete_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
