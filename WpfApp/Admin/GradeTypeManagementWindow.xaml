<Window x:Class="WpfApp.GradeTypeManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="Grading Structure" Height="680" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Course code as headline, name underneath -->
        <DataTemplate x:Key="CourseCellTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding Code, Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding Language, Mode=OneWay}"/>
                    <Run Text=" · Level "/>
                    <Run Text="{Binding Level, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- Where the course stands: balanced / incomplete / over / not set up -->
        <DataTemplate x:Key="WeightStatusTemplate">
            <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource TextSecondaryBrush}">
                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Balanced">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Incomplete">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Over">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="DocumentBulletList24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Grading Structure" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Pick a course to configure its grade components and weights"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Overview -->
            <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="statTotal" Text="0" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Available courses" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="statBalanced" Text="0" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryBrush}"/>
                        <TextBlock Text="Balanced (100%)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="statIncomplete" Text="0" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource InfoBrush}"/>
                        <TextBlock Text="Incomplete" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="statNotSetUp" Text="0" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Not set up" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Search -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtSearch" Width="260" Height="34"
                             VerticalContentAlignment="Center" Padding="6,0"/>
                    <Button Content="Search" Style="{StaticResource PillButton}" Width="84"
                            Margin="12,0,0,0" Click="BtnSearch_Click"/>
                    <Button Content="Reset" Style="{StaticResource PillButtonSubtle}" Width="84"
                            Margin="8,0,0,0" Click="BtnReset_Click"/>
                    <CheckBox x:Name="chkOnlyActive" Content="Only active courses" IsChecked="True"
                              VerticalAlignment="Center" Margin="20,0,0,0" Click="ChkOnlyActive_Click"/>
                </StackPanel>
            </Border>

            <!-- Course list -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgCourses" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="52" BorderThickness="0"
                              Background="Transparent" MouseDoubleClick="DgCourses_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Course" Width="*" CellTemplate="{StaticResource CourseCellTemplate}"/>
                            <DataGridTextColumn Header="Components" Binding="{Binding ComponentCount}" Width="120"/>
                            <DataGridTextColumn Header="Total weight" Binding="{Binding TotalWeightText}" Width="120"/>
                            <DataGridTemplateColumn Header="Status" Width="150" CellTemplate="{StaticResource WeightStatusTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="BookSearch24" FontSize="44"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No courses found" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="Clear the search, or untick “Only active courses”."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer: pager + actions -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <ctl:PagerBar x:Name="pager" HorizontalAlignment="Left" PageChanged="Pager_PageChanged"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Double-click a course to edit its structure"
                               VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Content="Configure" Style="{StaticResource PillButton}" Width="120" Click="BtnConfigure_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
