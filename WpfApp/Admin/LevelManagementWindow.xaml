<Window x:Class="WpfApp.LevelManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Levels" Height="660" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate x:Key="StatusBadgeTemplate">
            <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource SecondaryBrush}">
                <TextBlock x:Name="txt" Text="Active" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter TargetName="txt" Property="Text" Value="Inactive"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowSortUp24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Levels" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Pick a language on the left, then manage its levels"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Master: languages -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource BackgroundBrush}" Padding="12,10">
                        <TextBlock Text="Languages" FontWeight="SemiBold" FontSize="13"/>
                    </Border>
                    <ListBox x:Name="lstLanguages" BorderThickness="0" Background="Transparent"
                             SelectionChanged="LstLanguages_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="10,8"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Detail: that language's levels -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="tbLanguageName" FontSize="16" FontWeight="SemiBold"
                                   Text="Select a language"/>
                        <TextBlock x:Name="tbLanguageHint" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Its levels will appear below."/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <DataGrid x:Name="dgLevels" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" RowHeight="44" BorderThickness="0"
                                  Background="Transparent" MouseDoubleClick="DgLevels_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding SortOrder}" Width="60"/>
                                <DataGridTextColumn Header="Level" Binding="{Binding Name}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Courses" Binding="{Binding CourseCount}" Width="100"/>
                                <DataGridTemplateColumn Header="Status" Width="130" CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <ui:SymbolIcon Symbol="ArrowSortUp24" FontSize="40"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="tbEmpty" Text="No levels for this language yet"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,2"/>
                            <TextBlock Text="Click Add level to define one."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Move up"   Style="{StaticResource PillButtonSubtle}"  Width="100" Margin="0,0,8,0" Click="BtnMoveUp_Click"/>
                    <Button Content="Move down" Style="{StaticResource PillButtonSubtle}"  Width="110" Margin="0,0,8,0" Click="BtnMoveDown_Click"/>
                    <Button Content="Add level" Style="{StaticResource PillButton}"        Width="110" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                    <Button Content="Edit"      Style="{StaticResource PillButtonSuccess}" Width="90"  Margin="0,0,8,0" Click="BtnEdit_Click"/>
                    <Button Content="Delete"    Style="{StaticResource PillButtonDanger}"  Width="90"  Click="BtnDelete_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
