<Window x:Class="WpfApp.SessionRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Session Room Change" Height="640" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Room badge: teal when overridden, grey when using the class default -->
        <DataTemplate x:Key="RoomBadgeTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding RoomName}" VerticalAlignment="Center"/>
                <Border x:Name="tag" CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                        Background="{StaticResource InfoBrush}" Visibility="Collapsed">
                    <TextBlock Text="changed" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                    <Setter TargetName="tag" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Building24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Session Room Change" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Move a single session to another room without changing the class"
                               Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Class:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="cboClass" Width="300" Height="34" DisplayMemberPath="Display"
                              SelectedValuePath="ClassId" SelectionChanged="CboClass_SelectionChanged"/>
                    <TextBlock x:Name="tbDefaultRoom" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgSessions" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" BorderThickness="0" Background="Transparent" RowHeight="40"
                              MouseDoubleClick="DgSessions_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="120"/>
                            <DataGridTextColumn Header="Day" Binding="{Binding DayName}" Width="110"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="120"/>
                            <DataGridTemplateColumn Header="Room" Width="220" CellTemplate="{StaticResource RoomBadgeTemplate}"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="emptyState" Text="Pick a class to see its sessions."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Change Room" Style="{StaticResource PillButton}" Width="150" Click="BtnChangeRoom_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
