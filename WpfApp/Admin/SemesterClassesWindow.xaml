<Window x:Class="WpfApp.SemesterClassesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="Classes" Height="700" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate x:Key="ClassStatusTemplate">
            <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource PrimaryBrush}">
                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ONGOING">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="COMPLETED">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="CANCELLED">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Class name over the frozen course it was built from -->
        <DataTemplate x:Key="ClassCellTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="{Binding CourseSnapshot}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TeachersTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding PrimaryTeacherName}" FontSize="13"/>
                <TextBlock Text="{Binding OtherTeachers}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ClipboardTask24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="tbTitle" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="tbSubtitle" Foreground="#DCEBFF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtSearch" Width="260" Height="34"/>
                    <Button Content="Search" Style="{StaticResource PillButton}" Width="84"
                            Margin="12,0,0,0" Click="BtnSearch_Click"/>
                    <Button Content="Reset" Style="{StaticResource PillButtonSubtle}" Width="84"
                            Margin="8,0,0,0" Click="BtnReset_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgClasses" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="52" BorderThickness="0"
                              Background="Transparent" MouseDoubleClick="DgClasses_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Class" Width="*" CellTemplate="{StaticResource ClassCellTemplate}"/>
                            <DataGridTemplateColumn Header="Teachers" Width="200" CellTemplate="{StaticResource TeachersTemplate}"/>
                            <DataGridTextColumn Header="Room" Binding="{Binding RoomName}" Width="110"/>
                            <DataGridTextColumn Header="Enrolled" Binding="{Binding EnrolledDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Fee" Binding="{Binding FeeDisplay}" Width="130"/>
                            <DataGridTemplateColumn Header="Status" Width="120" CellTemplate="{StaticResource ClassStatusTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="ClipboardTask24" FontSize="44"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No classes in this semester yet" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="Click Add class to open one."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <ctl:PagerBar x:Name="pager" HorizontalAlignment="Left" PageChanged="Pager_PageChanged"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Enrollments" Style="{StaticResource PillButtonInfo}" Width="130" Margin="0,0,8,0" Click="BtnEnrollments_Click"/>
                    <Button Content="Add class"   Style="{StaticResource PillButton}"     Width="110" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                    <Button Content="Edit"        Style="{StaticResource PillButtonSuccess}" Width="90" Margin="0,0,8,0" Click="BtnEdit_Click"/>
                    <!-- Cancelling is the only status a human sets; the rest follow the dates. -->
                    <Button x:Name="btnCancel" Content="Cancel class" Style="{StaticResource PillButtonSubtle}" Width="120" Margin="0,0,8,0" Click="BtnCancelClass_Click"/>
                    <Button Content="Delete"      Style="{StaticResource PillButtonDanger}"  Width="90" Click="BtnDelete_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
