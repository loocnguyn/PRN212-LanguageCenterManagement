<Window x:Class="WpfApp.TopUpWalletWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Top Up Wallet" Height="260" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="tbBalance" Text="Current balance: 0"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Top-up amount:" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="txtAmount" Width="180" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnTopUp" Content="Pay with ZaloPay" Width="140" Height="32" Click="BtnTopUp_Click"/>
            <Button Content="Cancel" Width="80" Height="32" Margin="10,0,0,0" Click="BtnCancel_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="tbStatus" Text="" TextWrapping="Wrap" Foreground="DarkSlateGray"/>
    </Grid>
</Window>
