<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App color palette: Fluent blue primary + green secondary (success/active states) -->
    <Color x:Key="PrimaryColor">#0078D4</Color>
    <Color x:Key="PrimaryDarkColor">#005A9E</Color>
    <Color x:Key="PrimaryLightColor">#C7E0F4</Color>
    <Color x:Key="SecondaryColor">#107C10</Color>
    <Color x:Key="SecondaryLightColor">#DFF6DD</Color>
    <Color x:Key="DangerColor">#D13438</Color>
    <Color x:Key="InfoColor">#0B8A8F</Color>
    <Color x:Key="InfoDarkColor">#0A6E72</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BackgroundColor">#F3F3F3</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#5C5C5C</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLightColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoDarkBrush" Color="{StaticResource InfoDarkColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>

    <!-- Per-role accent colors (used for role badges and avatar bubbles) -->
    <SolidColorBrush x:Key="RoleAdminBrush"   Color="#D13438"/>
    <SolidColorBrush x:Key="RoleStaffBrush"   Color="#0078D4"/>
    <SolidColorBrush x:Key="RoleTeacherBrush" Color="#107C10"/>
    <SolidColorBrush x:Key="RoleStudentBrush" Color="#8764B8"/>

</ResourceDictionary>
