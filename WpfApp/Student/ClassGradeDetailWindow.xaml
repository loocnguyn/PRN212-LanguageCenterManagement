<Window x:Class="WpfApp.ClassGradeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grade Detail" Height="500" Width="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F4F8" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <TextBlock x:Name="tbClassName" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
        </Border>

        <DataGrid Grid.Row="1" x:Name="dgGrades"
                  AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="1" BorderBrush="LightGray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Grade Type"  Binding="{Binding GradeTypeName}"   Width="200"/>
                <DataGridTextColumn Header="Score"       Binding="{Binding ScoreDisplay}"     Width="120"/>
                <DataGridTextColumn Header="Weight %"    Binding="{Binding WeightPercent}"    Width="110"/>
                <DataGridTextColumn Header="Graded At"   Binding="{Binding GradedAtDisplay}"  Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="tbWeightedAverage" FontSize="14" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Window>
