<Window x:Class="WpfApp.MyClassesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="My Classes" Height="660" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Class name over course code — the two things a student identifies a class by -->
        <DataTemplate x:Key="ClassCellTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="{Binding CourseDisplay}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Where and when -->
        <DataTemplate x:Key="WhenCellTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DateRangeDisplay}" FontSize="13"/>
                <TextBlock Text="{Binding ClassroomName}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Status pill: blue upcoming, green ongoing, grey finished, red cancelled -->
        <DataTemplate x:Key="StatusCellTemplate">
            <Border x:Name="pill" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource PrimaryLightBrush}">
                <TextBlock x:Name="label" Text="{Binding ClassStatus}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ClassStatus}" Value="ONGOING">
                    <Setter TargetName="pill" Property="Background" Value="{StaticResource SecondaryLightBrush}"/>
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ClassStatus}" Value="COMPLETED">
                    <Setter TargetName="pill" Property="Background" Value="#EFEFEF"/>
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ClassStatus}" Value="CANCELLED">
                    <Setter TargetName="pill" Property="Background" Value="#FDE7E9"/>
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource RoleStudentBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Book24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="My Classes" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="tbStudentInfo" Foreground="#EFE6FF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="16,12">
            <TextBlock x:Name="tbSummary" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filters -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Semester" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cbSemester" MinWidth="180" Height="34"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CbSemester_SelectionChanged"/>

                    <TextBlock Text="Course" VerticalAlignment="Center" Margin="16,0,6,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cbCourse" MinWidth="220" Height="34"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CbCourse_SelectionChanged"/>

                    <CheckBox x:Name="cbShowAll" Content="Include finished and dropped"
                              VerticalAlignment="Center" Margin="20,0,0,0"
                              Checked="CbShowAll_Changed" Unchecked="CbShowAll_Changed"/>
                </StackPanel>
            </Border>

            <!-- Classes -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgClasses" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="52" BorderThickness="0"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Class" Width="*"
                                                    CellTemplate="{StaticResource ClassCellTemplate}"/>
                            <DataGridTextColumn Header="Semester" Binding="{Binding SemesterName}" Width="130"/>
                            <DataGridTextColumn Header="Teacher"  Binding="{Binding TeacherName}"  Width="150"/>
                            <DataGridTemplateColumn Header="Runs / room" Width="180"
                                                    CellTemplate="{StaticResource WhenCellTemplate}"/>
                            <DataGridTemplateColumn Header="Class" Width="110"
                                                    CellTemplate="{StaticResource StatusCellTemplate}"/>
                            <DataGridTextColumn Header="My enrollment" Binding="{Binding EnrollmentStatus}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="tbNoClasses" Text="You are not enrolled in any class."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
