<Window x:Class="WpfApp.MyClassesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Classes" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: student info -->
        <Border Grid.Row="0" Background="#F0F4F8" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <TextBlock x:Name="tbStudentInfo" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
        </Border>

        <!-- Filters: Semester -> Course, plus show-all toggle -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock Text="Semester:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cbSemester" Width="180" Height="34" SelectionChanged="CbSemester_SelectionChanged"/>
            <TextBlock Text="Course:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="cbCourse" Width="200" Height="34" SelectionChanged="CbCourse_SelectionChanged"/>
            <CheckBox x:Name="cbShowAll" Content="Show all (including past/dropped)" VerticalAlignment="Center" Margin="20,0,0,0" Checked="CbShowAll_Changed" Unchecked="CbShowAll_Changed"/>
            <TextBlock x:Name="tbSummary" VerticalAlignment="Center" Margin="24,0,0,0" FontSize="12" Foreground="#555"/>
        </StackPanel>

        <!-- Classes DataGrid -->
        <TextBlock Grid.Row="2" x:Name="tbNoClasses" Text="You are not enrolled in any class." FontSize="13" Foreground="#666" Margin="0,0,0,8" Visibility="Collapsed"/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <DataGrid x:Name="dgClasses"
                      AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="1" BorderBrush="LightGray">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Semester"            Binding="{Binding SemesterName}"       Width="130"/>
                    <DataGridTextColumn Header="Course"              Binding="{Binding CourseDisplay}"      Width="160"/>
                    <DataGridTextColumn Header="Class Name"          Binding="{Binding ClassName}"          Width="140"/>
                    <DataGridTextColumn Header="Teacher"             Binding="{Binding TeacherName}"        Width="140"/>
                    <DataGridTextColumn Header="Classroom"           Binding="{Binding ClassroomName}"      Width="120"/>
                    <DataGridTextColumn Header="Schedule Dates"      Binding="{Binding DateRangeDisplay}"   Width="150"/>
                    <DataGridTextColumn Header="Class Status"        Binding="{Binding ClassStatus}"        Width="110"/>
                    <DataGridTextColumn Header="Enrollment Status"   Binding="{Binding EnrollmentStatus}"   Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
    </Grid>
</Window>
