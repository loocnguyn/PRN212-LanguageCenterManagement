<Window x:Class="WpfApp.StudentGradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="My Grades" Height="640" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Class + course on one line, the way the student thinks of it -->
        <DataTemplate x:Key="ClassCellTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="{Binding CourseName}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <!-- The average as a pill; grey while the marks are still incomplete -->
        <DataTemplate x:Key="AverageCellTemplate">
            <Border x:Name="pill" CornerRadius="10" Padding="12,4" HorizontalAlignment="Left"
                    Background="{StaticResource SecondaryLightBrush}">
                <TextBlock x:Name="label" Text="{Binding AverageText}" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource SecondaryBrush}"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsComplete}" Value="False">
                    <Setter TargetName="pill" Property="Background" Value="#EFEFEF"/>
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource RoleStudentBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="BookStar24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="My Grades" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="tbStudentInfo" Foreground="#EFE6FF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <TextBlock x:Name="tbSummary" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Export transcript" Style="{StaticResource PillButtonInfo}" Width="150"
                            Margin="0,0,8,0" Click="BtnExportCsv_Click"/>
                    <Button Content="Refresh" Style="{StaticResource PillButtonSubtle}" Width="90"
                            Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filters -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Semester" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cbSemester" MinWidth="200" Height="34"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CbSemester_SelectionChanged"/>

                    <TextBlock Text="Course" VerticalAlignment="Center" Margin="16,0,6,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cbCourse" MinWidth="220" Height="34"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CbCourse_SelectionChanged"/>
                </StackPanel>
            </Border>

            <!-- Classes; double-click a row for the component breakdown -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgClasses" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="52" BorderThickness="0"
                              Background="Transparent"
                              MouseDoubleClick="DgClasses_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Class" Width="*"
                                                    CellTemplate="{StaticResource ClassCellTemplate}"/>
                            <DataGridTextColumn Header="Marks recorded" Binding="{Binding GradeCount}" Width="140"/>
                            <DataGridTemplateColumn Header="Weighted average" Width="200"
                                                    CellTemplate="{StaticResource AverageCellTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="emptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
