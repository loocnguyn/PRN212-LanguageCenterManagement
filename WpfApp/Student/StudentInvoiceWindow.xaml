<Window x:Class="WpfApp.StudentInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="My Invoices" Height="660" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Status pill: colour carries the meaning, so an unpaid invoice is spotted
             without reading every row. -->
        <DataTemplate x:Key="StatusCellTemplate">
            <Border x:Name="pill" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                    Background="{StaticResource PrimaryLightBrush}">
                <TextBlock x:Name="label" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="PARTIAL">
                    <Setter TargetName="pill" Property="Background" Value="#FFF4CE"/>
                    <Setter TargetName="label" Property="Foreground" Value="#8A6100"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="pill" Property="Background" Value="#FDE7E9"/>
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- What the invoice is for, and the discount that was applied to it -->
        <DataTemplate x:Key="ForCellTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{Binding DiscountText}" FontSize="11"
                           Foreground="{StaticResource SecondaryBrush}"
                           Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource RoleStudentBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ReceiptMoney24" Foreground="White" FontSize="26" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="My Invoices" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="tbStudentName" Foreground="#EFE6FF" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Wallet + actions -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Money24" FontSize="22" Margin="0,0,10,0"
                                       Foreground="{StaticResource SecondaryBrush}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Wallet balance" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="tbBalance" Text="0 đ" FontSize="19" FontWeight="Bold"
                                       Foreground="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Top up"          Style="{StaticResource PillButton}"        Width="100" Margin="0,0,8,0" Click="BtnTopUp_Click"/>
                        <Button Content="Pay selected"    Style="{StaticResource PillButtonSuccess}" Width="120" Margin="0,0,8,0" Click="BtnPayFromWallet_Click"/>
                        <Button Content="Wallet history"  Style="{StaticResource PillButtonInfo}"    Width="120" Margin="0,0,8,0" Click="BtnHistory_Click"/>
                        <Button Content="Refresh"         Style="{StaticResource PillButtonSubtle}"  Width="90"  Click="BtnReset_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- What is outstanding, at a glance -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0" MinWidth="150">
                    <StackPanel>
                        <TextBlock x:Name="statOutstanding" Text="0 đ" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="still to pay" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0" MinWidth="150">
                    <StackPanel>
                        <TextBlock x:Name="statPaid" Text="0 đ" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryBrush}"/>
                        <TextBlock Text="paid so far" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0" MinWidth="150">
                    <StackPanel>
                        <TextBlock x:Name="statSaved" Text="0 đ" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="saved by discounts" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,10" MinWidth="150">
                    <StackPanel>
                        <TextBlock x:Name="statOverdue" Text="0" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="past their due date" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Invoices -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="dgInvoices" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="52" BorderThickness="0"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding InvoiceId}" Width="55"/>
                            <DataGridTemplateColumn Header="For" Width="*"
                                                    CellTemplate="{StaticResource ForCellTemplate}"/>
                            <DataGridTextColumn Header="Billed" Binding="{Binding AmountText}" Width="120"/>
                            <DataGridTextColumn Header="Paid"   Binding="{Binding PaidText}"   Width="120"/>
                            <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingText}" Width="130"
                                                FontWeight="Bold"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding DueText}" Width="110"/>
                            <DataGridTemplateColumn Header="Status" Width="110"
                                                    CellTemplate="{StaticResource StatusCellTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="emptyState" Text="Nothing to pay — you are all settled. 🎉"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <ctl:PagerBar Grid.Row="3" x:Name="pager" HorizontalAlignment="Left"
                          Margin="0,12,0,0" PageChanged="Pager_PageChanged"/>
        </Grid>
    </DockPanel>
</Window>
