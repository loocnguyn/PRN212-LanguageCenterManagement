<Window x:Class="WpfApp.StudentInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:WpfApp.Controls"
        Title="My Invoices" Height="600" Width="1120"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="tbStudentName" Text="Student:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,20,0"/>
            <TextBlock x:Name="tbBalance" Text="Wallet balance: 0 VND" VerticalAlignment="Center" FontWeight="Bold" Foreground="DarkGreen"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Top Up Wallet" Width="130" Height="28" Click="BtnTopUp_Click"/>
            <Button Content="Wallet History" Width="110" Height="28" Margin="6,0,0,0" Click="BtnHistory_Click"/>
            <Button Content="Pay Tuition From Wallet" Width="165" Height="28" Margin="6,0,0,0" Click="BtnPayFromWallet_Click"/>
            <Button Content="Refresh" Width="80" Height="28" Margin="6,0,0,0" Click="BtnReset_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="dgInvoices"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Invoice ID" Binding="{Binding InvoiceId}" Width="90"/>
                <DataGridTextColumn Header="Original" Binding="{Binding OriginalAmount}" Width="105"/>
                <DataGridTextColumn Header="Discount" Binding="{Binding DiscountText}" Width="140"/>
                <DataGridTextColumn Header="Discount Amt" Binding="{Binding DiscountAmount}" Width="105"/>
                <DataGridTextColumn Header="Final Amount" Binding="{Binding Amount}" Width="110"/>
                <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount}" Width="110"/>
                <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount}" Width="120"/>
                <DataGridTextColumn Header="Discount Status" Binding="{Binding DiscountStatus}" Width="115"/>
                <DataGridTextColumn Header="Discount Deadline" Binding="{Binding DiscountDeadline}" Width="120"/>
                <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate}" Width="110"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <ctl:PagerBar Grid.Row="3" x:Name="pager" HorizontalAlignment="Left"
                      Margin="0,10,0,0" PageChanged="Pager_PageChanged"/>
    </Grid>
</Window>
