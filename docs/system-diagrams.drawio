        </mxCell>
        <mxCell id="ctxE13" value="Câu hỏi + ngữ cảnh /&#10;câu trả lời" style="endArrow=open;startArrow=open;endSize=8;startSize=8;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="c1" source="ctxSys" target="ctxGem">
